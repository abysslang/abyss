mem :: @import("std/mem")
job_entry :: @import("./thread_entry")

Void :: job_entry.Void
Handle :: extern ["pthread.h"] "pthread_t" struct {}
Attributes :: extern ["pthread.h"] "pthread_attr_t" struct {}
Lock :: extern ["pthread.h"] "pthread_mutex_t" struct {}
LockAttributes :: extern ["pthread.h"] "pthread_mutexattr_t" struct {}
Timespec :: extern ["time.h"] "struct timespec" struct {
    tv_sec  i64
    tv_nsec i64
}

create :: extern ["pthread.h"] "pthread_create" fn(&Handle, &Attributes, fn(&Void) &Void, &Void) i32
join_native :: extern ["pthread.h"] "pthread_join" fn(Handle, &&Void) i32
attr_init :: extern ["pthread.h"] "pthread_attr_init" fn(&Attributes) i32
attr_detach :: extern ["pthread.h"] "pthread_attr_setdetachstate" fn(&Attributes, i32) i32
attr_destroy :: extern ["pthread.h"] "pthread_attr_destroy" fn(&Attributes) i32
schedule :: extern ["sched.h"] "sched_yield" fn() i32
nanosleep :: extern ["time.h"] fn(&Timespec, &Timespec) i32
mutex_init :: extern ["pthread.h"] "pthread_mutex_init" fn(&Lock, &LockAttributes) i32
mutex_dispose :: extern ["pthread.h"] "pthread_mutex_destroy" fn(&Lock) i32
mutex_lock :: extern ["pthread.h"] "pthread_mutex_lock" fn(&Lock) i32
mutex_try :: extern ["pthread.h"] "pthread_mutex_trylock" fn(&Lock) i32
mutex_unlock :: extern ["pthread.h"] "pthread_mutex_unlock" fn(&Lock) i32

entry :: fn(job &Void) &Void {
    job_entry.run(job)
    0 as &Void
}

start :: fn(handle &Handle, job &u8, detached bool) i32 {
    if not detached { ret create(handle, 0 as &Attributes, entry, job as &Void) }
    attr: Attributes
    code := attr_init(&attr)
    if code != 0 { ret code }
    code = attr_detach(&attr, @c_value("pthread.h", "PTHREAD_CREATE_DETACHED", i32))
    if code == 0 { code = create(handle, &attr, entry, job as &Void) }
    attr_destroy(&attr)
    code
}

join :: fn(handle Handle) i32 { join_native(handle, 0 as &&Void) }

yield :: fn() { schedule() }

sleep :: fn(milliseconds u64) i32 {
    if milliseconds == 0 { ret 0 }
    seconds := milliseconds / 1000
    delay: Timespec = .{ tv_sec: seconds as i64, tv_nsec: ((milliseconds % 1000) * 1000000) as i64 }
    if delay.tv_sec < 0 or (delay.tv_sec as u64) != seconds {
        ret @c_value("errno.h", "EOVERFLOW", i32)
    }
    remaining: Timespec
    while nanosleep(&delay, &remaining) != 0 {
        code := @c_value("errno.h", "errno", i32)
        if code != @c_value("errno.h", "EINTR", i32) { ret code }
        delay = remaining
    }
    0
}

mutex_new :: fn(out &&Lock) i32 {
    lock := mem.malloc(@sizeof(Lock)) as &Lock
    if lock == (0 as &Lock) { ret @c_value("errno.h", "ENOMEM", i32) }
    code := mutex_init(lock, 0 as &LockAttributes)
    if code != 0 { mem.free(lock as &u8) } else { *out = lock }
    code
}

mutex_try_lock :: fn(lock &Lock) bool { mutex_try(lock) == 0 }

mutex_destroy :: fn(lock &Lock) i32 {
    code := mutex_try(lock)
    if code != 0 { ret code }
    code = mutex_unlock(lock)
    if code != 0 { ret code }
    code = mutex_dispose(lock)
    if code == 0 { mem.free(lock as &u8) }
    code
}
