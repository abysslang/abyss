id :: @import("./id")
Layout :: @import("./layout").Layout
Uses :: @import("./uses").Uses
fall :: @import("std/sys").fall
Val :: id.Val
Inst :: id.Inst
Block :: id.Block
Edge :: id.Edge
Use :: id.Use
Symbol :: id.Symbol
Ty :: @import("./ops").Ty
Op :: @import("./ops").Op
fold :: @import("./opt/fold")

terminates :: fn(op Op) bool {
    op as u8 >= Op.jump as u8 and op as u8 <= Op.trap as u8
}

binary :: fn(op Op) bool {
    op as u8 <= Op.shr as u8
}

fixed_uses :: fn(op Op) u64 {
    if op == Op.copy_bytes { ret 3 }
    if binary(op) or op == Op.offset or op == Op.store or op == Op.copy { ret 2 }
    match op {
        neg, invert, cast, load, zero, branch, ret_ { 1 }
        else { 0 }
    }
}

Graph :: struct {
    ops         Vec(Op)
    words       Vec(u32)
    results     Vec(Val)
    types       Vec(Ty)
    defs        Vec(Inst)
    param_start Vec(u32)
    param_count Vec(u32)
    param_space Vec(u32)
    params      Vec(Val)
    targets     Vec(Block)
    arg_start   Vec(u32)
    arg_count   Vec(u32)
    arg_space   Vec(u32)
    uses        Uses

    new :: fn() Self {
        .{
            ops: Vec(Op).empty()
            words: Vec(u32).empty()
            results: Vec(Val).empty()
            types: Vec(Ty).empty()
            defs: Vec(Inst).empty()
            param_start: Vec(u32).empty()
            param_count: Vec(u32).empty()
            param_space: Vec(u32).empty()
            params: Vec(Val).empty()
            targets: Vec(Block).empty()
            arg_start: Vec(u32).empty()
            arg_count: Vec(u32).empty()
            arg_space: Vec(u32).empty()
            uses: Uses.new()
        }
    }

    destroy :: fn(self &Self) {
        self.ops.destroy()
        self.words.destroy()
        self.results.destroy()
        self.types.destroy()
        self.defs.destroy()
        self.param_start.destroy()
        self.param_count.destroy()
        self.param_space.destroy()
        self.params.destroy()
        self.targets.destroy()
        self.arg_start.destroy()
        self.arg_count.destroy()
        self.arg_space.destroy()
        self.uses.destroy()
    }

    value :: fn(self &Self, ty Ty, def Inst) Val {
        value := id.next_id(Val, self.types.len)
        self.types.push(ty)
        self.defs.push(def)
        self.uses.heads.push(Use.none)
        value
    }

    inst :: fn(self &Self, op Op, ty Ty, left, right, extra u32) Inst {
        inst := id.next_id(Inst, self.ops.len)
        value := if ty == Ty.void_ { Val.none } else { self.value(ty, inst) }
        self.ops.push(op)
        self.results.push(value)
        self.words.push(left)
        self.words.push(right)
        self.words.push(extra)
        inst
    }

    word :: fn(self &Self, inst Inst, position u64) u32 {
        self.words.get(id.slot(inst) * 3 + position)
    }

    edge :: fn(self &Self, target Block, args Slice(Val)) Edge {
        edge := id.next_id(Edge, self.targets.len)
        self.targets.push(target)
        self.arg_start.push(0)
        self.arg_count.push(0)
        self.arg_space.push(0)
        self.set_edge(edge, target, args)
        edge
    }

    set_edge :: fn(self &Self, edge Edge, target Block, args Slice(Val)) {
        at := id.slot(edge)
        first := self.arg_start.get(at)
        previous := self.arg_count.get(at) as u64
        if args.len <= self.arg_space.get(at) as u64 {
            pos: u64 = 0
            while pos < previous or pos < args.len {
                value := if pos < args.len { args.get(pos) } else { Val.none }
                self.uses.set((first + pos as u32) as Use, value)
                pos = pos + 1
            }
        } else {
            last := first as u64 + previous
            use := first as u64
            while use < last {
                self.uses.set(use as Use, Val.none)
                use = use + 1
            }
            first = id.next_id(Use, self.uses.values.len) as u32
            for value in args { self.uses.add(value) }
            self.arg_space.set(at, args.len as u32)
        }
        self.targets.set(at, target)
        self.arg_start.set(at, first)
        self.arg_count.set(at, args.len as u32)
    }

    remove_edge_arg :: fn(self &Self, edge Edge, position u32) {
        at := id.slot(edge)
        count := self.arg_count.get(at)
        if position >= count { #fall }
        first := self.arg_start.get(at)
        pos := position
        while pos + 1 < count {
            next := self.uses.value(first + pos + 1)
            self.uses.set((first + pos) as Use, next)
            pos = pos + 1
        }
        self.uses.set((first + count - 1) as Use, Val.none)
        self.arg_count.set(at, count - 1)
    }

    append_arg :: fn(self &Self, edge Edge, value Val) {
        at := id.slot(edge)
        count := self.arg_count.get(at)
        first := self.arg_start.get(at)
        if count == self.arg_space.get(at) {
            start := id.next_id(Use, self.uses.values.len) as u32
            space := count * 2 + 1
            pos: u32 = 0
            while pos < count {
                self.uses.add(self.uses.value(first + pos))
                self.uses.set((first + pos) as Use, Val.none)
                pos = pos + 1
            }
            while pos < space {
                self.uses.add(Val.none)
                pos = pos + 1
            }
            self.arg_start.set(at, start)
            self.arg_space.set(at, space)
            first = start
        }
        self.uses.set((first + count) as Use, value)
        self.arg_count.set(at, count + 1)
    }
}

Function :: struct {
    graph   Graph
    layout  Layout
    current Block

    new :: fn() Self {
        .{ graph: Graph.new(), layout: Layout.new(), current: Block.none }
    }

    destroy :: fn(self &Self) {
        self.graph.destroy()
        self.layout.destroy()
    }

    block :: fn(self &Self) Block {
        self.block_with_params(Slice(Ty).empty())
    }

    block_with_param :: fn(self &Self, ty Ty) Block {
        self.block_with_params(Slice(Ty).new(&ty, 1))
    }

    block_with_params :: fn(self &Self, params Slice(Ty)) Block {
        block := id.next_id(Block, self.graph.param_count.len)
        self.graph.param_start.push(self.graph.types.len as u32)
        self.graph.param_count.push(params.len as u32)
        self.graph.param_space.push(0)
        for ty in params {
            if ty == Ty.void_ { #fall }
            self.graph.value(ty, Inst.none)
        }
        self.layout.add_block()
        block
    }

    block_count :: fn(self &Self) u64 {
        self.graph.param_count.len
    }

    value_count :: fn(self &Self) u64 {
        self.graph.types.len
    }

    parameter_count :: fn(self &Self, block Block) u32 {
        self.graph.param_count.get(id.slot(block))
    }

    parameter :: fn(self &Self, block Block, position u32) Val {
        if position >= self.parameter_count(block) { #fall }
        at := id.slot(block)
        first := self.graph.param_start.get(at) + position
        if self.graph.param_space.get(at) == 0 { ret (first + 1) as Val }
        self.graph.params.get(first as u64)
    }

    append_parameter :: fn(self &Self, block Block, ty Ty) Val {
        if block == Block.entry or ty == Ty.void_ { #fall }
        graph := &self.graph
        at := id.slot(block)
        count := self.parameter_count(block)
        space := graph.param_space.get(at)
        first := graph.param_start.get(at)
        if space == 0 or count == space {
            first = graph.params.len as u32
            space = count * 2 + 1
            graph.params.reserve(space as u64)
            pos: u32 = 0
            while pos < count {
                graph.params.push(self.parameter(block, pos))
                pos = pos + 1
            }
            while pos < space {
                graph.params.push(Val.none)
                pos = pos + 1
            }
            graph.param_space.set(at, space)
            graph.param_start.set(at, first)
        }
        param := graph.value(ty, Inst.none)
        graph.params.set((first + count) as u64, param)
        graph.param_count.set(at, count + 1)
        param
    }

    append_argument :: fn(self &Self, edge Edge, value Val) {
        target := self.edge_target(edge)
        pos := self.argument_count(edge)
        if self.value_type(self.parameter(target, pos)) != self.value_type(value) { #fall }
        self.graph.append_arg(edge, value)
    }

    remove_parameter :: fn(self &Self, block Block, position u32) {
        if block == Block.entry { #fall }
        count := self.parameter_count(block)
        if position >= count { #fall }
        removed := self.parameter(block, position)
        if self.has_uses(removed) { #fall }
        graph := &self.graph
        at := id.slot(block)
        space := graph.param_space.get(at)
        if space == 0 {
            first := graph.params.len as u32
            kept := if count > 1 { count - 1 } else { 0 }
            if kept > 0 {
                graph.params.reserve(kept as u64)
                pos: u32 = 0
                while pos < count {
                    if pos != position { graph.params.push(self.parameter(block, pos)) }
                    pos = pos + 1
                }
            }
            graph.param_start.set(at, first)
            graph.param_space.set(at, if kept == 0 { 1 as u32 } else { kept })
        } else {
            first := graph.param_start.get(at)
            pos := position
            while pos + 1 < count {
                graph.params.set((first + pos) as u64, graph.params.get((first + pos + 1) as u64))
                pos = pos + 1
            }
            graph.params.set((first + count - 1) as u64, Val.none)
        }
        graph.types.set(id.slot(removed), Ty.void_)
        graph.defs.set(id.slot(removed), Inst.none)
        graph.param_count.set(at, count - 1)
    }

    clear_parameters :: fn(self &Self, block Block) {
        if block == Block.entry { #fall }
        count := self.parameter_count(block)
        pos: u32 = 0
        while pos < count {
            param := self.parameter(block, pos)
            if self.has_uses(param) { #fall }
            self.graph.types.set(id.slot(param), Ty.void_)
            self.graph.defs.set(id.slot(param), Inst.none)
            pos = pos + 1
        }
        self.graph.param_count.set(id.slot(block), 0)
    }

    begin :: fn(self &Self, block Block) {
        if self.current != Block.none or id.slot(block) >= self.block_count() { #fall }
        last := self.last_inst(block)
        if last != Inst.none and terminates(self.opcode(last)) { #fall }
        self.current = block
    }

    suspend :: fn(self &Self) {
        self.current = Block.none
    }

    first_inst :: fn(self &Self, block Block) Inst {
        self.layout.first.get(id.slot(block))
    }

    last_inst :: fn(self &Self, block Block) Inst {
        self.layout.last.get(id.slot(block))
    }

    next_inst :: fn(self &Self, inst Inst) Inst {
        self.layout.next.get(id.slot(inst))
    }

    prev_inst :: fn(self &Self, inst Inst) Inst {
        self.layout.prev.get(id.slot(inst))
    }

    inst_block :: fn(self &Self, inst Inst) Block {
        if id.slot(inst) >= self.graph.ops.len { ret Block.none }
        self.layout.owner.get(id.slot(inst))
    }

    opcode :: fn(self &Self, inst Inst) Op {
        self.graph.ops.get(id.slot(inst))
    }

    result :: fn(self &Self, inst Inst) Val {
        self.graph.results.get(id.slot(inst))
    }

    defining_inst :: fn(self &Self, value Val) Inst {
        if value == Val.none { ret Inst.none }
        self.graph.defs.get(id.slot(value))
    }

    value_type :: fn(self &Self, value Val) Ty {
        at := id.slot(value)
        if at >= self.graph.types.len { ret Ty.void_ }
        self.graph.types.get(at)
    }

    operand :: fn(self &Self, inst Inst, position u64) Val {
        op := self.opcode(inst)
        if op == Op.call or op == Op.call_indirect {
            if position >= self.graph.word(inst, 2) as u64 { ret Val.none }
            ret self.graph.uses.value(self.graph.word(inst, 1) + position as u32)
        }
        if position >= fixed_uses(op) { ret Val.none }
        self.graph.uses.value(self.graph.word(inst, position))
    }

    payload :: fn(self &Self, inst Inst, position u64) u32 {
        self.graph.word(inst, position)
    }

    emit :: fn(self &Self, op Op, ty Ty, left, right, extra u32) Val {
        self.layout.add_inst()
        inst := self.graph.inst(op, ty, left, right, extra)
        self.append(inst)
        self.result(inst)
    }

    binary :: fn(self &Self, op Op, lhs, rhs Val) Val {
        ty := self.value_type(lhs)
        if ty == Ty.void_ or self.value_type(rhs) != ty { #fall }
        value := if (op as u8 >= Op.eq as u8) and (op as u8 <= Op.ge as u8) {
            Ty.i1
        } else {
            ty
        }
        if not binary(op) { #fall }
        folded := self.fold_values(op, value, lhs, rhs)
        if folded.is_some() { ret self.constant(value, folded.value) }
        self.emit(op, value, self.graph.uses.add(lhs), self.graph.uses.add(rhs), 0)
    }

    unary :: fn(self &Self, op Op, value Val) Val {
        if op != Op.neg and op != Op.invert { #fall }
        ty := self.value_type(value)
        folded := self.fold_values(op, ty, value, Val.none)
        if folded.is_some() { ret self.constant(ty, folded.value) }
        self.emit(op, ty, self.graph.uses.add(value), 0, 0)
    }

    cast :: fn(self &Self, ty Ty, value Val) Val {
        if self.value_type(value) == ty { ret value }
        folded := self.fold_values(Op.cast, ty, value, Val.none)
        if folded.is_some() { ret self.constant(ty, folded.value) }
        self.emit(Op.cast, ty, self.graph.uses.add(value), 0, 0)
    }

    fold_values :: fn(self &Self, op Op, ty Ty, lhs, rhs Val) Maybe(u64) {
        left := self.defining_inst(lhs)
        if left == Inst.none or self.opcode(left) != Op.constant { ret Maybe(u64).none() }
        bits := self.constant_bits(left)
        source := self.value_type(lhs)
        if rhs == Val.none { ret fold.unary(op, source, ty, bits) }
        right := self.defining_inst(rhs)
        if right == Inst.none or self.opcode(right) != Op.constant { ret Maybe(u64).none() }
        fold.binary(op, source, bits, self.constant_bits(right))
    }

    constant_bits :: fn(self &Self, inst Inst) u64 {
        self.payload(inst, 0) as u64 | (self.payload(inst, 1) as u64 << 32)
    }

    fold_inst :: fn(self &Self, inst Inst) bool {
        op := self.opcode(inst)
        if not binary(op) and op != Op.neg and op != Op.invert and op != Op.cast { ret false }
        value := self.result(inst)
        folded := self.fold_values(
            op
            self.value_type(value)
            self.operand(inst, 0)
            self.operand(inst, 1)
        )
        if folded.is_none() { ret false }
        for pos in Range.new(0, (fixed_uses(op) as i32)) {
            self.graph.uses.set(self.payload(inst, pos as u64) as Use, Val.none)
        }
        self.graph.ops.set(id.slot(inst), Op.constant)
        word := id.slot(inst) * 3
        self.graph.words.set(word, folded.value as u32)
        self.graph.words.set(word + 1, (folded.value >> 32) as u32)
        true
    }

    constant :: fn(self &Self, ty Ty, bits u64) Val {
        self.emit(Op.constant, ty, bits as u32, (bits >> 32) as u32, 0)
    }

    stack :: fn(self &Self, size, align u32) Val {
        self.emit(Op.stack, Ty.ptr, size, align, 0)
    }

    stack_layout :: fn(self &Self, layout u32) Val {
        self.emit(Op.stack, Ty.ptr, layout, 0, 1)
    }

    size_of :: fn(self &Self, layout u32) Val {
        self.emit(Op.abi_size, Ty.u64_, layout, 0, 0)
    }

    field_offset :: fn(self &Self, layout, index, format u32) Val {
        self.emit(Op.abi_field, Ty.u64_, layout, index, format)
    }

    header_value :: fn(self &Self, ty Ty, header, name u32) Val {
        self.emit(Op.c_value, ty, header, name, 0)
    }

    address :: fn(self &Self, symbol Symbol) Val {
        self.emit(Op.address, Ty.ptr, symbol as u32, 0, 0)
    }

    offset :: fn(self &Self, base, index Val, stride u32) Val {
        self.emit(Op.offset, Ty.ptr, self.graph.uses.add(base), self.graph.uses.add(index), stride)
    }

    load :: fn(self &Self, ty Ty, address Val) Val {
        self.emit(Op.load, ty, self.graph.uses.add(address), 0, 0)
    }

    store :: fn(self &Self, address, value Val) {
        self.emit(Op.store, Ty.void_, self.graph.uses.add(address), self.graph.uses.add(value), 0)
    }

    copy :: fn(self &Self, dest, source Val, size u32) {
        self.emit(Op.copy, Ty.void_, self.graph.uses.add(dest), self.graph.uses.add(source), size)
    }

    copy_bytes :: fn(self &Self, dest, source, count Val) {
        self.emit(
            Op.copy_bytes
            Ty.void_
            self.graph.uses.add(dest)
            self.graph.uses.add(source)
            self.graph.uses.add(count)
        )
    }

    zero :: fn(self &Self, dest Val, size u32) {
        self.emit(Op.zero, Ty.void_, self.graph.uses.add(dest), size, 0)
    }

    zero_layout :: fn(self &Self, dest Val, layout u32) {
        self.emit(Op.zero, Ty.void_, self.graph.uses.add(dest), layout, 1)
    }

    call :: fn(self &Self, symbol Symbol, ty Ty, args Slice(Val)) Val {
        first := id.next_id(Use, self.graph.uses.values.len)
        for value in args { self.graph.uses.add(value) }
        self.emit(Op.call, ty, symbol as u32, first as u32, args.len as u32)
    }

    call_indirect :: fn(self &Self, address Val, ty Ty, args Slice(Val)) Val {
        self.call_abi(address, ty, args, 0)
    }

    call_abi :: fn(self &Self, address Val, ty Ty, args Slice(Val), signature u32) Val {
        first := self.graph.uses.add(address)
        for value in args { self.graph.uses.add(value) }
        self.emit(Op.call_indirect, ty, signature, first, args.len as u32 + 1)
    }

    successor :: fn(self &Self, inst Inst, position u64) Edge {
        op := self.opcode(inst)
        if op == Op.jump and position == 0 { ret self.graph.word(inst, 0) as Edge }
        if op == Op.branch and position < 2 { ret self.graph.word(inst, position + 1) as Edge }
        Edge.none
    }

    edge_target :: fn(self &Self, edge Edge) Block {
        self.graph.targets.get(id.slot(edge))
    }

    argument_count :: fn(self &Self, edge Edge) u32 {
        self.graph.arg_count.get(id.slot(edge))
    }

    argument :: fn(self &Self, edge Edge, position u32) Val {
        if position >= self.argument_count(edge) { #fall }
        self.graph.uses.value(self.graph.arg_start.get(id.slot(edge)) + position)
    }

    append :: fn(self &Self, inst Inst) {
        if self.current == Block.none { #fall }
        self.layout.append(self.current, inst)
        if terminates(self.opcode(inst)) { self.current = Block.none }
    }

    make_iadd :: fn(self &Self, lhs, rhs Val) Inst {
        ty := self.value_type(lhs)
        if ty == Ty.void_ or self.value_type(rhs) != ty { #fall }
        left := self.graph.uses.add(lhs)
        right := self.graph.uses.add(rhs)
        self.layout.add_inst()
        self.graph.inst(Op.iadd, ty, left, right, 0)
    }

    iadd :: fn(self &Self, lhs, rhs Val) Val {
        self.binary(Op.iadd, lhs, rhs)
    }

    insert_iadd_before :: fn(self &Self, before Inst, lhs, rhs Val) Val {
        if self.inst_block(before) == Block.none { #fall }
        inst := self.make_iadd(lhs, rhs)
        self.layout.insert_before(before, inst)
        self.result(inst)
    }

    rewrite_iadd :: fn(self &Self, inst Inst, lhs, rhs Val) bool {
        if self.inst_block(inst) == Block.none or self.opcode(inst) != Op.iadd { ret false }
        ty := self.value_type(self.result(inst))
        if self.value_type(lhs) != ty or self.value_type(rhs) != ty { ret false }
        self.graph.uses.set(self.graph.word(inst, 0) as Use, lhs)
        self.graph.uses.set(self.graph.word(inst, 1) as Use, rhs)
        true
    }

    move_before :: fn(self &Self, inst, before Inst) bool {
        if self.inst_block(inst) == Block.none or terminates(self.opcode(inst)) { ret false }
        if self.inst_block(before) == Block.none { ret false }
        if inst != before {
            self.layout.unlink(inst)
            self.layout.insert_before(before, inst)
        }
        true
    }

    replace_uses :: fn(self &Self, from, to Val) bool {
        ty := self.value_type(from)
        if ty == Ty.void_ or self.value_type(to) != ty { ret false }
        self.graph.uses.replace(from, to)
        true
    }

    has_uses :: fn(self &Self, value Val) bool {
        self.value_type(value) != Ty.void_ and self.graph.uses.head(value) != Use.none
    }

    remove :: fn(self &Self, inst Inst) bool {
        if self.inst_block(inst) == Block.none { ret false }
        op := self.opcode(inst)
        value := self.result(inst)
        if value != Val.none {
            if self.has_uses(value) { ret false }
            self.graph.types.set(id.slot(value), Ty.void_)
            self.graph.defs.set(id.slot(value), Inst.none)
        }
        pos: u64 = 0
        if op == Op.call or op == Op.call_indirect {
            while pos < self.graph.word(inst, 2) as u64 {
                self.graph.uses.set((self.graph.word(inst, 1) + pos as u32) as Use, Val.none)
                pos = pos + 1
            }
        } else {
            while pos < fixed_uses(op) {
                self.graph.uses.set(self.graph.word(inst, pos) as Use, Val.none)
                pos = pos + 1
            }
        }
        pos = 0
        edge := self.successor(inst, pos)
        while edge != Edge.none {
            self.graph.set_edge(edge, Block.none, Slice(Val).empty())
            pos = pos + 1
            edge = self.successor(inst, pos)
        }
        self.layout.unlink(inst)
        true
    }

    accepts :: fn(self &Self, target Block, args Slice(Val)) bool {
        if id.slot(target) >= self.block_count() or
            args.len != self.parameter_count(target) as u64 {
            ret false
        }
        pos: u32 = 0
        for value in args {
            if self.value_type(value) != self.value_type(self.parameter(target, pos)) { ret false }
            pos = pos + 1
        }
        true
    }

    retarget :: fn(self &Self, edge Edge, target Block, args Slice(Val)) bool {
        if id.slot(edge) >= self.graph.targets.len or self.edge_target(edge) == Block.none {
            ret false
        }
        if not self.accepts(target, args) { ret false }
        self.graph.set_edge(edge, target, args)
        true
    }

    fold_branch :: fn(self &Self, inst Inst, keep u64) bool {
        if self.inst_block(inst) == Block.none or self.opcode(inst) != Op.branch or keep > 1 {
            ret false
        }
        self.graph.uses.set(self.payload(inst, 0) as Use, Val.none)
        kept := self.successor(inst, keep)
        dropped := self.successor(inst, 1 - keep)
        self.graph.set_edge(dropped, Block.none, Slice(Val).empty())
        self.graph.ops.set(id.slot(inst), Op.jump)
        word := id.slot(inst) * 3
        self.graph.words.set(word, kept as u32)
        self.graph.words.set(word + 1, 0)
        self.graph.words.set(word + 2, 0)
        true
    }

    swap_branch :: fn(self &Self, inst Inst, cond Val) bool {
        if self.inst_block(inst) == Block.none or self.opcode(inst) != Op.branch or
            self.value_type(cond) != Ty.i1 {
            ret false
        }
        self.graph.uses.set(self.payload(inst, 0) as Use, cond)
        word := id.slot(inst) * 3
        first := self.graph.words.get(word + 1)
        second := self.graph.words.get(word + 2)
        self.graph.words.set(word + 1, second)
        self.graph.words.set(word + 2, first)
        true
    }

    splice_block :: fn(self &Self, dest Block, jump Inst, source Block) {
        if dest == source or self.inst_block(jump) != dest or self.opcode(jump) != Op.jump {
            #fall
        }
        if not self.remove(jump) { #fall }
        inst := self.first_inst(source)
        while inst != Inst.none {
            next := self.next_inst(inst)
            self.layout.unlink(inst)
            self.layout.append(dest, inst)
            inst = next
        }
        self.clear_parameters(source)
    }

    strip_uses :: fn(self &Self, inst Inst) {
        op := self.opcode(inst)
        pos: u64 = 0
        if op == Op.call or op == Op.call_indirect {
            while pos < self.graph.word(inst, 2) as u64 {
                self.graph.uses.set((self.graph.word(inst, 1) + pos as u32) as Use, Val.none)
                pos = pos + 1
            }
        } else {
            while pos < fixed_uses(op) {
                self.graph.uses.set(self.graph.word(inst, pos) as Use, Val.none)
                pos = pos + 1
            }
        }
        pos = 0
        edge := self.successor(inst, pos)
        while edge != Edge.none {
            self.graph.set_edge(edge, Block.none, Slice(Val).empty())
            pos = pos + 1
            edge = self.successor(inst, pos)
        }
    }

    jump :: fn(self &Self, target Block) {
        self.jump_with_args(target, Slice(Val).empty())
    }

    jump_with_args :: fn(self &Self, target Block, args Slice(Val)) {
        if not self.accepts(target, args) { #fall }
        edge := self.graph.edge(target, args)
        self.layout.add_inst()
        self.append(self.graph.inst(Op.jump, Ty.void_, edge as u32, 0, 0))
    }

    jump_value :: fn(self &Self, target Block, value Val) {
        self.jump_with_args(target, Slice(Val).new(&value, 1))
    }

    branch :: fn(self &Self, cond Val, yes, no Block) {
        empty := Slice(Val).empty()
        self.branch_with_args(cond, yes, empty, no, empty)
    }

    branch_with_args :: fn(
        self &Self
        cond Val
        yes Block
        yes_args Slice(Val)
        no Block
        no_args Slice(Val)
    ) {
        if self.value_type(cond) != Ty.i1 or not self.accepts(yes, yes_args) or
            not self.accepts(no, no_args) { #fall }
        cond_use := self.graph.uses.add(cond)
        first := self.graph.edge(yes, yes_args)
        second := self.graph.edge(no, no_args)
        self.layout.add_inst()
        self.append(self.graph.inst(Op.branch, Ty.void_, cond_use, first as u32, second as u32))
    }

    ret_value :: fn(self &Self, value Val) {
        if self.value_type(value) == Ty.void_ { #fall }
        self.emit(Op.ret_, Ty.void_, self.graph.uses.add(value), 0, 0)
    }

    ret_void :: fn(self &Self) {
        self.emit(Op.ret_, Ty.void_, 0, 0, 0)
    }

    trap :: fn(self &Self) {
        self.emit(Op.trap, Ty.void_, 0, 0, 0)
    }
}
