clock :: @import("std/sys/clock")
native_output :: @import("core/target_values").native_output
Arena :: @import("std/allocator").Arena
String :: @import("std/string").String
fmt :: @import("std/fmt")
sys :: @import("std/sys")

Mode :: enum u8 {
    off
    summary
    text
    tsv
}

Phase :: enum u8 {
    off
    other
    driver_read
    driver_setup
    driver_write
    driver_cleanup
    frontend_lex
    frontend_parse
    frontend_modules
    type_resolve
    type_check
    type_check_match
    type_check_synth
    type_check_globals
    type_infer
    type_infer_templates
    type_infer_apply
    type_infer_rebuild
    type_infer_union
    type_calls
    type_specialize
    type_specialize_nominal
    type_reflection
    comptime_splice
    comptime_evaluate
    comptime_lower
    comptime_vm
    backend_lower
    backend_functions
    backend_globals
    backend_metadata
    backend_optimize
    backend_cfg
    backend_mem2reg
    backend_fold
    backend_dce
    backend_prune
    backend_c99
    backend_c99_abi
    backend_c99_body
    backend_elf
    backend_elf_symbols
    backend_elf_body
    backend_elf_abi
    backend_regalloc
    backend_elf_write
    backend_vm_lower
    backend_vm_link
    end_
}

label :: fn(phase Phase) Str {
    match phase {
        driver_read { "driver/read" }
        driver_setup { "driver/setup" }
        driver_write { "driver/write" }
        driver_cleanup { "driver/cleanup" }
        frontend_lex { "frontend/lex" }
        frontend_parse { "frontend/parse" }
        frontend_modules { "frontend/modules" }
        type_resolve { "type/resolve" }
        type_check { "type/check" }
        type_check_match { "type/check_match" }
        type_check_synth { "type/check_synth" }
        type_check_globals { "type/check_globals" }
        type_infer { "type/infer" }
        type_infer_templates { "type/infer_templates" }
        type_infer_apply { "type/infer_apply" }
        type_infer_rebuild { "type/infer_rebuild" }
        type_infer_union { "type/infer_union" }
        type_calls { "type/calls" }
        type_specialize { "type/specialize" }
        type_specialize_nominal { "type/specialize_nominal" }
        type_reflection { "type/reflection" }
        comptime_splice { "comptime/splice" }
        comptime_evaluate { "comptime/evaluate" }
        comptime_lower { "comptime/lower" }
        comptime_vm { "comptime/vm" }
        backend_lower { "backend/lower" }
        backend_functions { "backend/functions" }
        backend_globals { "backend/globals" }
        backend_metadata { "backend/metadata" }
        backend_optimize { "backend/optimize" }
        backend_cfg { "backend/cfg" }
        backend_mem2reg { "backend/mem2reg" }
        backend_fold { "backend/fold" }
        backend_dce { "backend/dce" }
        backend_prune { "backend/prune" }
        backend_c99 { "backend/c99" }
        backend_c99_abi { "backend/c99_abi" }
        backend_c99_body { "backend/c99_body" }
        backend_elf { "backend/elf" }
        backend_elf_symbols { "backend/elf_symbols" }
        backend_elf_body { "backend/elf_body" }
        backend_elf_abi { "backend/elf_abi" }
        backend_regalloc { "backend/regalloc" }
        backend_elf_write { "backend/elf_write" }
        backend_vm_lower { "backend/vm_lower" }
        backend_vm_link { "backend/vm_link" }
        else { "other" }
    }
}

Sample :: struct {
    exclusive, inclusive, calls, depth u64
    entered, allocated                 u64
}

Span :: struct {
    parent Phase
}

Session :: struct {
    mode                       Mode
    active                     Phase
    started, switched          u64
    samples                    [Phase.end_ as u64]Sample
    sources                    Vec(Str)
    total, files, lines, bytes u64
}

state: Session

clock_expr :: fn() Str {
    if native_output { "clock.monotonic()" } else { "0 as u64" }
}

rss_expr :: fn() Str {
    if native_output { "clock.peak_rss()" } else { "0 as u64" }
}

timestamp :: fn() u64 {
    now := #clock_expr()
    if now == 0 {
        sys.write_stderr("Could not read the monotonic host clock\n")
        sys.exit_process(1)
    }
    now
}

start :: fn(mode Mode) {
    if mode == Mode.off { ret }
    if not native_output or not clock.supported() {
        sys.write_stderr("Profiling requires a monotonic host clock\n")
        sys.exit_process(1)
    }
    fresh: Session
    state = fresh
    state.mode = mode
    state.sources = Vec(Str).new()
    if mode != Mode.summary {
        state.active = Phase.other
    }
    state.started = timestamp()
    state.switched = state.started
}

enabled :: fn() bool { state.mode != Mode.off }

inferring :: fn() bool { state.active == Phase.type_infer_apply }

allocation :: fn(size u64, result &u8) {
    active := state.active
    if active != Phase.off and result != (0 as &u8) {
        slot := &state.samples[active as u64]
        slot.allocated = slot.allocated + size
    }
}

enter :: fn(phase Phase) Span {
    parent := state.active
    if parent == Phase.off or phase == parent { ret .{ parent: Phase.off } }
    now := timestamp()
    previous := &state.samples[parent as u64]
    previous.exclusive = previous.exclusive + (now - state.switched)
    slot := &state.samples[phase as u64]
    if slot.depth == 0 { slot.entered = now }
    slot.depth = slot.depth + 1
    slot.calls = slot.calls + 1
    state.active = phase
    state.switched = now
    .{ parent: parent }
}

leave :: fn(span Span) {
    if span.parent == Phase.off { ret }
    now := timestamp()
    slot := &state.samples[state.active as u64]
    slot.exclusive = slot.exclusive + (now - state.switched)
    slot.depth = slot.depth - 1
    if slot.depth == 0 {
        slot.inclusive = slot.inclusive + (now - slot.entered)
    }
    state.active = span.parent
    state.switched = now
}

source :: fn(text Str) {
    if enabled() { state.sources.push(text) }
}

count_source :: fn(text Str) {
    state.files = state.files + 1
    state.bytes = state.bytes + text.len
    if text.len == 0 { ret }
    for byte in text {
        if byte == 10 { state.lines = state.lines + 1 }
    }
    if text.ptr[text.len - 1] != 10 { state.lines = state.lines + 1 }
}

stop :: fn() {
    if not enabled() { ret }
    now := timestamp()
    state.total = now - state.started
    if state.active != Phase.off {
        other := &state.samples[Phase.other as u64]
        other.exclusive = other.exclusive + (now - state.switched)
        other.inclusive = other.exclusive
        state.active = Phase.off
    }
}

millis :: fn(nanos u64) f64 { nanos as f64 / 1000000.0 }

share :: fn(nanos u64) f64 {
    if state.total == 0 { ret 0.0 }
    nanos as f64 * 100.0 / state.total as f64
}

group :: fn(name Str) Str {
    length: u64 = 0
    while length < name.len and name.ptr[length] != 47 { length = length + 1 }
    name.sub(0, length)
}

ReportRow :: struct {
    name  Str
    nanos u64
    phase Phase
}

rank :: fn(rows &Vec(ReportRow), item ReportRow) {
    index := rows.len
    rows.push(item)
    while index > 0 {
        previous := rows.get(index - 1)
        if previous.nanos >= item.nanos { break }
        rows.set(index, previous)
        index = index - 1
    }
    rows.set(index, item)
}

rank_group :: fn(rows &Vec(ReportRow), name Str, nanos u64) {
    if nanos != 0 { rank(rows, .{ name: name, nanos: nanos, phase: Phase.off }) }
}

row :: fn(out &String, name Str, sample Sample) {
    if state.mode == Mode.tsv {
        fmt.fmt_into(
            out
            "phase\t{}\t{}\t{}\t{}\t{}\n"
            .(
                name
                sample.exclusive
                sample.inclusive
                sample.calls
                sample.allocated
            )
        )
    } else {
        fmt.fmt_into(
            out
            "  {}\t{} ms\t{}%\t{} ms inclusive\t{} spans\t{} MiB allocated\n"
            .(
                name
                millis(sample.exclusive)
                share(sample.exclusive)
                millis(sample.inclusive)
                sample.calls
                sample.allocated as f64 / 1048576.0
            )
        )
    }
}

report :: fn(arena &Arena) {
    if not enabled() { ret }
    rss := #rss_expr()
    for source in state.sources { count_source(source) }
    state.sources.destroy()
    allocated: u64 = 0
    for index in Range.new(Phase.other as i32, Phase.end_ as i32) {
        allocated = allocated + state.samples[index as u64].allocated
    }
    out := String.new(arena)
    if state.mode == Mode.text {
        throughput := if state.total == 0 { 0.0 } else {
            state.lines as f64 * 1000000000.0 / state.total as f64
        }
        fmt.fmt_into(
            &out
            "Compile: {} ms | {} lines/s | {} lines in {} files\n"
            .(
                millis(state.total)
                throughput as u64
                state.lines
                state.files
            )
        )
        if rss != 0 {
            fmt.fmt_into(&out, "Peak RSS: {} MiB\n", .(rss as f64 / 1048576.0))
        } else { out.push_str("Peak RSS: unavailable\n") }
        fmt.fmt_into(&out, "Heap requested: {} MiB\n", .(allocated as f64 / 1048576.0))
        out.push_str(
            "Phase\tExclusive time\tShare of compile\tInclusive time\tSpans\tHeap requested\n"
        )
    } else {
        fmt.fmt_into(
            &out
            "abyss-profile\t2\nsummary\t{}\t{}\t{}\t{}\t{}\t{}\n"
            .(
                state.total
                state.lines
                state.files
                state.bytes
                rss
                allocated
            )
        )
    }
    if state.mode != Mode.summary {
        first := Phase.other as i32
        end := Phase.end_ as i32
        rows := Vec(ReportRow).new()
        for index in Range.new(first, end) {
            item := state.samples[index as u64]
            if item.calls == 0 and index != first { cont }
            phase := index as Phase
            name := label(phase)
            if state.mode == Mode.text {
                rank(&rows, .{ name: name, nanos: item.exclusive, phase: phase })
            } else { row(&out, name, item) }
        }
        if state.mode == Mode.text {
            for item in rows { row(&out, item.name, state.samples[item.phase as u64]) }
            rows.clear()
            out.push_str("Group totals (exclusive):\n")
            previous := Str.empty()
            nanos: u64 = 0
            typer: u64 = 0
            check: u64 = 0
            infer: u64 = 0
            for index in Range.new(first, end) {
                phase := label(index as Phase)
                name := group(phase)
                elapsed := state.samples[index as u64].exclusive
                if not previous.eq(name) {
                    rank_group(&rows, previous, nanos)
                    previous = name
                    nanos = 0
                }
                if name.eq("type") or name.eq("comptime") { typer = typer + elapsed }
                if phase.eq("type/check") or phase.starts_with("type/check_") {
                    check = check + elapsed
                }
                if phase.eq("type/infer") or phase.starts_with("type/infer_") {
                    infer = infer + elapsed
                }
                nanos = nanos + elapsed
            }
            rank_group(&rows, previous, nanos)
            rank_group(&rows, "type checker and comptime", typer)
            rank_group(&rows, "checking (subset of type)", check)
            rank_group(&rows, "inference (subset of type)", infer)
            for item in rows {
                fmt.fmt_into(
                    &out
                    "  {}\t{} ms\t{}%\n"
                    .(item.name, millis(item.nanos), share(item.nanos))
                )
            }
        }
        rows.destroy()
    }
    sys.write_stderr(out.as_str())
    state.mode = Mode.off
    state.active = Phase.off
}
