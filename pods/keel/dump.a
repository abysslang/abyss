ir :: @import("./ir")
id :: @import("./id")
write_str :: @import("std/io").write_str

edge_text :: fn(func &ir.Function, edge id.Edge) {
    printf("b{}", .(id.slot(func.edge_target(edge))))
    count := func.argument_count(edge)
    if count == 0 { ret }
    write_str("(")
    pos: u32 = 0
    while pos < count {
        if pos > 0 { write_str(", ") }
        printf("v{}", .(id.slot(func.argument(edge, pos))))
        pos = pos + 1
    }
    write_str(")")
}

dump :: fn(name Str, func &ir.Function) {
    printf("air {}\n", .(name))
    block: u64 = 0
    while block < func.block_count() {
        key := (block + 1) as id.Block
        printf("b{}", .(block))
        count := func.parameter_count(key)
        if count > 0 {
            write_str("(")
            pos: u32 = 0
            while pos < count {
                if pos > 0 { write_str(", ") }
                value := func.parameter(key, pos)
                label := if func.value_type(value) == ir.Ty.i1 { "i1" } else { "i32" }
                printf("v{}: {}", .(id.slot(value), label))
                pos = pos + 1
            }
            write_str(")")
        }
        write_str(":\n")
        inst := func.first_inst(key)
        while inst != id.Inst.none {
            match func.opcode(inst) {
                iadd {
                    printf(
                        "  v{} = iadd i32 v{}, v{}\n"
                        .(
                            id.slot(func.result(inst))
                            id.slot(func.operand(inst, 0))
                            id.slot(func.operand(inst, 1))
                        )
                    )
                }
                jump {
                    write_str("  jump ")
                    edge_text(func, func.successor(inst, 0))
                    write_str("\n")
                }
                branch {
                    printf("  branch v{}, ", .(id.slot(func.operand(inst, 0))))
                    edge_text(func, func.successor(inst, 0))
                    write_str(", ")
                    edge_text(func, func.successor(inst, 1))
                    write_str("\n")
                }
                ret_ { printf("  ret v{}\n", .(id.slot(func.operand(inst, 0)))) }
            }
            inst = func.next_inst(inst)
        }
        block = block + 1
    }
}
