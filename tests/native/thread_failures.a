thread :: @import("std/thread")
sys :: @import("std/sys")

inject :: extern "thread_test_inject" fn(mode i32)
balance :: extern "thread_test_balance" fn() i32
monotonic_ns :: extern "thread_test_monotonic_ns" fn() u64

expect :: fn(ok bool) {
    if not ok { sys.fall_at(@source_location()) }
}

answer :: fn() i32 { 42 }

discard :: fn(value i32) { expect(value == 42) }

test_sleep :: fn() {
    inject(5)
    expect(thread.sleep(0).is_success())
    problem := thread.sleep(1).unwrap_error()
    expect(problem.kind == thread.ErrorKind.system and problem.code == 104)

    inject(6)
    expect(thread.sleep(1250).is_success())

    inject(8)
    expect(thread.sleep(~(0 as u64)).is_success())

    start := monotonic_ns()
    expect(thread.sleep(20).is_success())
    expect(monotonic_ns() - start >= 20000000)
}

main :: fn() {
    test_sleep()
    inject(1)
    expect(thread.spawn(answer).unwrap_error().kind == thread.ErrorKind.allocation)
    expect(balance() == 0)

    inject(2)
    failed := thread.spawn(answer).unwrap_error()
    expect(failed.kind == thread.ErrorKind.system and failed.code == 101)
    expect(balance() == 0)

    inject(2)
    expect(thread.spawn_detached(discard, 42 as i32).unwrap_error().code == 101)
    expect(balance() == 0)

    worker := thread.spawn(answer).unwrap()
    expect(balance() == 1)
    inject(3)
    expect(worker.join().unwrap_error().code == 102)
    expect(balance() == 1)
    expect(worker.join().unwrap() == 42)
    expect(balance() == 0)

    inject(1)
    expect(thread.Mutex(i32).new(0 as i32).unwrap_error().kind == thread.ErrorKind.system)
    expect(balance() == 0)

    inject(4)
    expect(thread.Mutex(i32).new(0 as i32).unwrap_error().code == 103)
    expect(balance() == 0)

    expect(thread.spawn_detached(discard, 42 as i32).is_success())
    while balance() != 0 { thread.yield() }
}
