format :: @import("std/fmt")
String :: @import("std/string").String
Arena :: @import("std/allocator").Arena
print :: @import("std/io").print
printf :: @import("std/io").printf

Pattern :: "{} + {} = {}"

advance :: fn(counter &i32) i32 {
    *counter = *counter + 1
    *counter
}

main :: fn() {
    owner := Arena.new(64)
    arena := &owner
    text: String = format.fmt(arena, "{}", .(100))
    print(text)
    print(format.fmt(arena, Pattern, .(2, 3, 5)))
    print(format.fmt(arena, "{{{}}} {{}}", .(42)))
    print(format.fmt(arena, "no arguments", .()))
    print(format.fmt(arena, "", .()))
    print(format.fmt(arena, "{} {} {}", .(true, 1.5 as f32, -2.25 as f64)))
    print(format.fmt(arena, "{} {}", .(Str.new(c"bounded-extra", 7), c"cstring")))
    print(format.fmt(arena, "quotes: \"{}\"\\end", .("text")))
    print(format.fmt(arena, "سلام {}", .(7)))
    printf("without newline:{}", .(10))
    print(" next line")
    #print(20)
    count := 0
    print(format.fmt(arena, "{} {}", .(advance(&count), advance(&count))))
    print(count)
    binary := format.fmt(arena, "<{}>", .(Str.new(c"a\000b", 3)))
    print(binary.len == 5)
    print(*(binary.ptr + 2) == 0 as u8)
    print(text)
    out := String.new(arena)
    out.reserve(128)
    out.push_str("prefix")
    ptr := out.ptr
    cap := out.cap
    format.fmt_into(&out, "", .())
    print(out.ptr == ptr and out.cap == cap and out.as_str().eq("prefix"))
    format.fmt_into(&out, " {{{}}}", .(-42))
    format.fmt_into(&out, " {} {}", .(advance(&count), advance(&count)))
    print(out)
    format.fmt_into(&out, " <{}>", .(Str.new(c"a\000b", 3)))
    print(out.len == 22 and *(out.ptr + 19) == 0 as u8 and *(out.ptr + 21) == 62 as u8)
    print(out.ptr == ptr and out.cap == cap)
    while out.len < cap { out.push_char(120) }
    format.fmt_into(&out, "<{}>", .(false))
    print(out.len == cap + 7 and out.cap > cap and out.as_str().starts_with("prefix {-42} 3 4"))
    print(out.as_str().ends_with("<false>"))
    owner.destroy()
}
