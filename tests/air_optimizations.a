diamond :: fn(flag bool, left, right i32) i32 {
    result: i32
    if flag { result = left, {} } else { result = right, {} }
    result
}

swap_loop :: fn(count i32) i32 {
    left := 1
    right := 2
    index := 0
    while index < count {
        previous := left
        left = right
        right = previous
        index = index + 1
    }
    left * 10 + right
}

folded :: fn() i32 {
    factor := 3
    factor * (15 + ((-2 as i8) >> 1) as i32)
}

poke :: fn(value &i32) { *value = 42 }

escaped :: fn() i32 {
    value := 1
    poke(&value)
    value
}

dce_chain :: fn(x i32) i32 {
    dead_math := ((x + 1) * 3) ^ 7
    dead_pair := .(x, dead_math)
    dead_local: i32 = dead_pair.0 + dead_math
    dead_local = dead_local + 1
    x + 5
}

dead_loop_var :: fn(n i32) i32 {
    keep := 1
    unused := 0
    i := 0
    while i < n {
        keep = keep + 2
        unused = unused + i * 3 + 1
        i = i + 1
    }
    keep
}

cfg_simplify :: fn(x i32) i32 {
    dead := if 2 > 5 { x * 99 } else { 3 }
    same := if x > 0 { 10 } else { 10 }
    inv := if not (x == 0) { 4 } else { 1 }
    dead + same + inv
}

keep_effects :: fn(x, y i32) i32 {
    ignored := x / y
    ignored * 0 + x + 1
}

main :: fn() {
    print(diamond(true, 8, 13))
    print(diamond(false, 8, 13))
    print(swap_loop(0))
    print(swap_loop(5))
    print(swap_loop(6))
    print(folded())
    print(escaped())
    print(dce_chain(4))
    print(dead_loop_var(5))
    print(cfg_simplify(0))
    print(cfg_simplify(7))
    print(keep_effects(20, 4))
}
