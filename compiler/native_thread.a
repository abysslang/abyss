is_symbol :: fn(name Str) bool { name.starts_with("abyss_native_thread_") }

posix :: `
#include <errno.h>
#include <pthread.h>
#include <sched.h>
#include <time.h>

typedef char AbyssThreadHandleFits[(sizeof(pthread_t) <= sizeof(uint64_t)) ? 1 : -1];

static void *abyss_thread_entry(void *job) {
    void (*run)(uint8_t *);
    memcpy(&run, job, sizeof(run));
    run(job);
    return NULL;
}

static int32_t abyss_native_thread_start(uint64_t *handle, uint8_t *job, bool detached) {
    pthread_t thread;
    if (detached) {
        pthread_attr_t attr;
        int err = pthread_attr_init(&attr);
        if (err) return err;
        err = pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
        if (!err) err = pthread_create(&thread, &attr, abyss_thread_entry, job);
        pthread_attr_destroy(&attr);
        return err;
    }
    int err = pthread_create(&thread, NULL, abyss_thread_entry, job);
    if (!err) {
        *handle = 0;
        memcpy(handle, &thread, sizeof(thread));
    }
    return err;
}

static int32_t abyss_native_thread_join(uint64_t handle) {
    pthread_t thread;
    memcpy(&thread, &handle, sizeof(thread));
    return pthread_join(thread, NULL);
}

static void abyss_native_thread_yield(void) { sched_yield(); }

static int32_t abyss_native_thread_sleep(uint64_t milliseconds) {
    if (!milliseconds) return 0;
    uint64_t seconds = milliseconds / 1000;
    struct timespec delay = { (time_t)seconds, (long)(milliseconds % 1000) * 1000000 };
    if (delay.tv_sec < 0 || (uint64_t)delay.tv_sec != seconds) return EOVERFLOW;
    struct timespec remaining;
    while (nanosleep(&delay, &remaining) != 0) {
        if (errno != EINTR) return errno;
        delay = remaining;
    }
    return 0;
}

static int32_t abyss_native_thread_mutex_new(uint8_t **out) {
    pthread_mutex_t *lock = malloc(sizeof(*lock));
    if (!lock) return ENOMEM;
    int err = pthread_mutex_init(lock, NULL);
    if (err) free(lock);
    else *out = (uint8_t *)lock;
    return err;
}

static int32_t abyss_native_thread_mutex_destroy(uint8_t *lock) {
    pthread_mutex_t *mutex = (pthread_mutex_t *)lock;
    int err = pthread_mutex_trylock(mutex);
    if (err) return err;
    pthread_mutex_unlock(mutex);
    err = pthread_mutex_destroy(mutex);
    if (!err) free(mutex);
    return err;
}

static int32_t abyss_native_thread_mutex_lock(uint8_t *lock) {
    return pthread_mutex_lock((pthread_mutex_t *)lock);
}

static bool abyss_native_thread_mutex_try_lock(uint8_t *lock) {
    return pthread_mutex_trylock((pthread_mutex_t *)lock) == 0;
}

static int32_t abyss_native_thread_mutex_unlock(uint8_t *lock) {
    return pthread_mutex_unlock((pthread_mutex_t *)lock);
}

`

windows :: `
#include <errno.h>
#include <process.h>

extern uint32_t abyss_win_wait(void *, uint32_t) __asm__("WaitForSingleObject");
extern int32_t abyss_win_close(void *) __asm__("CloseHandle");
extern uint32_t abyss_win_error(void) __asm__("GetLastError");
extern int32_t abyss_win_yield(void) __asm__("SwitchToThread");
extern void abyss_win_sleep(uint32_t) __asm__("Sleep");
extern void abyss_win_lock_init(void **) __asm__("InitializeSRWLock");
extern void abyss_win_lock(void **) __asm__("AcquireSRWLockExclusive");
extern uint8_t abyss_win_try_lock(void **) __asm__("TryAcquireSRWLockExclusive");
extern void abyss_win_unlock(void **) __asm__("ReleaseSRWLockExclusive");

static unsigned __stdcall abyss_thread_entry(void *job) {
    void (*run)(uint8_t *);
    memcpy(&run, job, sizeof(run));
    run(job);
    return 0;
}

static int32_t abyss_native_thread_start(uint64_t *handle, uint8_t *job, bool detached) {
    uintptr_t thread = _beginthreadex(NULL, 0, abyss_thread_entry, job, 0, NULL);
    if (!thread) return errno;
    if (detached) abyss_win_close((void *)thread);
    else *handle = thread;
    return 0;
}

static int32_t abyss_native_thread_join(uint64_t handle) {
    void *thread = (void *)(uintptr_t)handle;
    if (abyss_win_wait(thread, UINT32_MAX) != 0) return abyss_win_error();
    return abyss_win_close(thread) ? 0 : abyss_win_error();
}

static void abyss_native_thread_yield(void) { abyss_win_yield(); }

static int32_t abyss_native_thread_sleep(uint64_t milliseconds) {
    const uint32_t max_delay = UINT32_MAX - 1;
    while (milliseconds > max_delay) {
        abyss_win_sleep(max_delay);
        milliseconds -= max_delay;
    }
    if (milliseconds) abyss_win_sleep((uint32_t)milliseconds);
    return 0;
}

static int32_t abyss_native_thread_mutex_new(uint8_t **out) {
    void **lock = malloc(sizeof(*lock));
    if (!lock) return ENOMEM;
    abyss_win_lock_init(lock);
    *out = (uint8_t *)lock;
    return 0;
}

static int32_t abyss_native_thread_mutex_destroy(uint8_t *lock) {
    if (!abyss_win_try_lock((void **)lock)) return EBUSY;
    abyss_win_unlock((void **)lock);
    free(lock);
    return 0;
}

static int32_t abyss_native_thread_mutex_lock(uint8_t *lock) {
    abyss_win_lock((void **)lock);
    return 0;
}

static bool abyss_native_thread_mutex_try_lock(uint8_t *lock) {
    return abyss_win_try_lock((void **)lock) != 0;
}

static int32_t abyss_native_thread_mutex_unlock(uint8_t *lock) {
    abyss_win_unlock((void **)lock);
    return 0;
}

`
