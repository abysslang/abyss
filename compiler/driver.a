target :: @import("core/target")
Arena :: @import("std/allocator").Arena
Env :: @import("std/env").Env
fs :: @import("std/fs")
sys :: @import("std/sys")

c99 :: @import("pods/keel/target/c99")
x86_64 :: @import("pods/keel/target/x86_64")
air :: @import("compiler/air/lower")
profile :: @import("pods/keel/profile")
Phase :: profile.Phase

system_malloc :: extern "malloc" fn(size u64) &u8
system_realloc :: extern "realloc" fn(ptr &u8, size u64) &u8

profile_malloc :: extern "abyss_compiler_profile_malloc" fn(size u64) &u8 {
    ptr := system_malloc(size)
    profile.allocation(size, ptr)
    ptr
}

profile_realloc :: extern "abyss_compiler_profile_realloc" fn(ptr &u8, size u64) &u8 {
    result := system_realloc(ptr, size)
    profile.allocation(size, result)
    result
}
Engine :: @import("compiler/engine").Engine
id_none :: @import("compiler/nexus/pool").id_none
platform :: @import("compiler/platform")
TyKind :: @import("compiler/types").TyKind
vm_codegen :: @import("compiler/vm/codegen")
Vm :: @import("compiler/vm/vm").Vm

CompilerConfig :: struct {
    src_path     &u8
    out_path     &u8
    is_vm_run    bool
    emit_object  bool
    hosted_obj   bool
    import_dirs  Vec(Str)
    map_keys     Vec(Str)
    map_values   Vec(Str)
    target_os    target.Os
    target_arch  target.Arch
    is_library   bool
    source_index i32
    profiling    profile.Mode
    from_env :: fn() Self {
        argc := Env.args_len()
        src := Env.get_or(c"ABYSS_SRC", c"main.a")
        out := Env.get_or(c"ABYSS_OUT", c"out.c")
        vm_run := Env.has(c"ABYSS_VM")
        emit_object := false
        hosted_obj := false
        import_dirs := Vec(Str).new()
        map_keys := Vec(Str).new()
        map_values := Vec(Str).new()
        target_os := platform.host_os()
        arch := Maybe(target.Arch).none()
        library := false
        profiling := profile.Mode.off

        pos_idx: i32 = 0
        source_index: i32 = 0
        i: i32 = 1
        while i < argc {
            arg_cstr := Env.arg(i)
            arg_str := Str.of(arg_cstr)
            if arg_str.eq("r") or arg_str.eq("run") {
                vm_run = true
            } else if arg_str.eq("b") or arg_str.eq("build") {
                vm_run = false
            } else if arg_str.eq("--version") {
                print("abyssc target-aware")
                sys.exit_process(0)
            } else if arg_str.eq("--target") {
                i = i + 1
                os := platform.parse_os(Str.of(Env.arg(i)))
                if os.is_none() {
                    print("--target expects linux, windows, darwin, wasi, or freestanding")
                    #sys.fall
                }
                target_os = os.unwrap()
            } else if arg_str.eq("--arch") {
                i = i + 1
                arch = platform.parse_arch(Str.of(Env.arg(i)))
                if arch.is_none() {
                    print("--arch expects x86_64, aarch64, or wasm32")
                    #sys.fall
                }
            } else if arg_str.eq("--emit-obj") {
                emit_object = true
            } else if arg_str.eq("--hosted") {
                hosted_obj = true
            } else if arg_str.eq("--library") {
                library = true
            } else if arg_str.eq("--profile") {
                profiling = profile.Mode.text
            } else if arg_str.eq("--profile=tsv") {
                profiling = profile.Mode.tsv
            } else if arg_str.eq("--profile=summary") {
                profiling = profile.Mode.summary
            } else if arg_str.starts_with("--profile=") {
                sys.write_stderr("--profile expects tsv or summary (omit the value for text)\n")
                #sys.fall
            } else if arg_str.eq("-I") {
                if (i + 1) < argc {
                    i = i + 1
                    import_dirs.push(Str.of(Env.arg(i)))
                }
            } else if arg_str.starts_with("-I") and (arg_str.len > 2) {
                import_dirs.push(arg_str.sub(2, arg_str.len - 2))
            } else if arg_str.eq("--map") {
                if (i + 1) < argc {
                    i = i + 1
                    map_arg := Str.of(Env.arg(i))
                    eq_idx: u64 = 0
                    found_eq := false
                    while eq_idx < map_arg.len {
                        if *(map_arg.ptr + eq_idx) == ('=' as u8) {
                            found_eq = true
                            break
                        }
                        eq_idx = eq_idx + 1
                    }
                    if found_eq {
                        map_keys.push(map_arg.sub(0, eq_idx))
                        map_values.push(map_arg.sub(eq_idx + 1, map_arg.len - eq_idx - 1))
                    }
                }
            } else {
                if pos_idx == 0 {
                    src = arg_cstr
                    source_index = i
                    pos_idx = 1
                } else if pos_idx == 1 {
                    out = arg_cstr
                    pos_idx = 2
                }
            }
            i = i + 1
        }

        target_arch := arch.unwrap_or(
            if target_os == target.Os.wasi {
                target.Arch.wasm32
            } else if platform.host_arch() == target.Arch.wasm32 and
                target_os != target.Os.freestanding {
                target.Arch.x86_64
            } else {
                platform.host_arch()
            }
        )
        if (target_os == target.Os.wasi and target_arch != target.Arch.wasm32) or
            (
                target_arch == target.Arch.wasm32 and target_os != target.Os.wasi and
                    target_os != target.Os.freestanding
            ) {
            print("unsupported target OS and architecture combination")
            #sys.fall
        }
        if vm_run and
            (library or target_os != platform.host_os() or target_arch != platform.host_arch()) {
            print("VM execution requires a program for the host target")
            #sys.fall
        }
        if emit_object {
            if vm_run or target_os != target.Os.linux or target_arch != target.Arch.x86_64 {
                sys.write_stderr("--emit-obj requires a Linux x86_64 build\n")
                #sys.fall
            }
            if pos_idx < 2 { out = c"out.o" }
        }
        if hosted_obj and not emit_object {
            sys.write_stderr("--hosted requires --emit-obj\n")
            #sys.fall
        }
        .{
            src_path: src
            out_path: out
            is_vm_run: vm_run
            emit_object: emit_object
            hosted_obj: hosted_obj
            import_dirs: import_dirs
            map_keys: map_keys
            map_values: map_values
            target_os: target_os
            target_arch: target_arch
            is_library: library
            source_index: source_index
            profiling: profiling
        }
    }
}

Driver :: struct {
    arena  &Arena
    config CompilerConfig
    new :: fn(arena &Arena) Self {
        .{ arena: arena, config: CompilerConfig.from_env() }
    }

    with_config :: fn(arena &Arena, config CompilerConfig) Self {
        .{ arena: arena, config: config }
    }

    run :: fn(self &Self) {
        profile.start(self.config.profiling)
        read := profile.enter(Phase.driver_read)
        source := fs.read_file(self.arena, self.config.src_path)
        profile.leave(read)
        setup := profile.enter(Phase.driver_setup)
        eng := Engine.new(self.arena)
        eng.nexus.target_os = self.config.target_os
        eng.nexus.target_arch = self.config.target_arch
        i: u64 = 0
        while i < self.config.import_dirs.len {
            eng.nexus.import_dirs.push(self.config.import_dirs.get(i))
            i = i + 1
        }
        j: u64 = 0
        while j < self.config.map_keys.len {
            eng.nexus.map_keys.push(self.config.map_keys.get(j))
            eng.nexus.map_values.push(self.config.map_values.get(j))
            j = j + 1
        }
        executable := not self.config.is_library and self.config.target_os != target.Os.freestanding
        eng.nexus.native_output = not self.config.is_vm_run
        eng.nexus.native_executable = executable and eng.nexus.native_output
        profile.leave(setup)
        fid := eng.add_file_with_runtime(
            Str.of(self.config.src_path)
            source
            not self.config.emit_object or (executable and self.config.hosted_obj)
        )
        sym_id := eng.build_entry(fid, executable)

        if self.config.is_vm_run {
            lower := profile.enter(Phase.backend_vm_lower)
            vcg := vm_codegen.VmCodeGen.new(self.arena)
            vcg.init_types(&eng.nexus.types, self.arena)
            vbuilder := vm_codegen.VmCodeBuilder.new(&vcg)
            vcg.abyss_main(sym_id)
            eng.compile_vm(&vcg, &vbuilder, sym_id)
            profile.leave(lower)
            link := profile.enter(Phase.backend_vm_link)
            vcg.finish_linking()
            profile.leave(link)
            profile.stop()
            profile.report(self.arena)
            vm := Vm.new()
            Env.shift_args(self.config.source_index)
            if vcg.globals_entry != id_none() {
                vm.run(&vcg.chunk, vcg.globals_entry)
            }
            status := vm.run(&vcg.chunk, vcg.main_entry)
            vm.destroy()
            vcg.destroy()
            if eng.nexus.types.kind(eng.nexus.types.func_return(eng.type_of(sym_id))) !=
                TyKind.unit {
                sys.exit_process(status as i32)
            }
            ret
        }
        program := air.lower(&eng.nexus, self.arena, fid, sym_id, id_none())
        output := if self.config.emit_object {
            x86_64.emit(self.arena, &program, executable, self.config.hosted_obj)
        } else {
            c99.emit(self.arena, &program, self.config.target_os, executable)
        }
        write := profile.enter(Phase.driver_write)
        fs.write_file(self.config.out_path, output)
        profile.leave(write)
        cleanup := profile.enter(Phase.driver_cleanup)
        program.destroy()
        profile.leave(cleanup)
        profile.stop()
        profile.report(self.arena)
    }
}
