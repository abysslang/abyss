profile :: @import("pods/keel/profile")
Phase :: profile.Phase
Os :: @import("core/target").Os
Arena :: @import("std/allocator").Arena
Path :: @import("std/path").Path
fall :: @import("std/sys").fall
current_dir :: @import("std/sys/current_dir").current_dir

air_lower :: @import("./air/lower")
hir :: @import("./hir")
keel :: @import("pods/keel")
modules :: @import("./modules")
lex :: @import("./lexer").lex
lower_function :: @import("./lower").lower_function
VmCodeGen :: @import("./vm/codegen").VmCodeGen
VmCodeBuilder :: @import("./vm/codegen").VmCodeBuilder
Nexus :: @import("./nexus/nexus").Nexus
id_none :: @import("./nexus/pool").id_none
Parser_new :: @import("./parser/core").Parser_new
parse_file :: @import("./parser/parser").parse_file
TokenStream :: @import("./token").TokenStream
check_global_var :: @import("./typer/global").check_global_var
tyck :: @import("./typer/tyck")
type_defs :: @import("./types")
slot_none :: @import("./unify").slot_none

Engine :: struct {
    nexus         Nexus
    arena         &Arena
    tokens        TokenStream
    splice_tokens TokenStream
    new :: fn(arena &Arena) Self {
        res: Self = .{
            nexus: Nexus.new()
            arena: arena
            tokens: TokenStream.new()
            splice_tokens: TokenStream.new()
        }
        res.nexus.init_tuple_names()
        res
    }

    destroy :: fn(self &Self) {
        self.tokens.destroy()
        self.splice_tokens.destroy()
        self.nexus.destroy()
    }

    parse_module :: fn(self &Self, fid u32) {
        db := &self.nexus
        self.tokens.clear()
        source := db.get_file_source(fid)
        profile.source(source)
        lex(&self.tokens, source, db.get_file_path(fid))
        span := profile.enter(Phase.frontend_parse)
        parser := Parser_new(
            db
            &self.tokens
            &db.hir
            fid
            id_none()
            0
            (self.tokens.count() as u32) - 1
        )
        parse_file(&parser)
        parser.env.destroy()
        profile.leave(span)
    }

    load_module :: fn(self &Self, fid u32, offset u32, base, path Str) u32 {
        count := self.nexus.file_paths.len as u32
        span := profile.enter(Phase.frontend_modules)
        module := modules.resolve_module(&self.nexus, self.arena, fid, offset, base, path)
        profile.leave(span)
        if module == count {
            self.parse_module(module)
        }
        module
    }

    add_file :: fn(self &Self, path, source Str) u32 {
        self.add_file_with_runtime(path, source, true)
    }

    add_file_with_runtime :: fn(self &Self, path, source Str, c_runtime bool) u32 {
        db := &self.nexus
        db.cwd = Path.normalize(self.arena, current_dir(self.arena))
        normalized := Path.normalize(self.arena, path)
        fid := db.add_file(normalized, source, modules.file_key(db, self.arena, normalized))
        self.parse_module(fid)
        db.core_prelude = self.load_module(fid, 0, Str.empty(), "core/prelude")
        db.std_prelude = self.load_module(fid, 0, Str.empty(), "std/prelude")
        if db.native_output and c_runtime {
            wasi := db.target_os == Os.wasi
            if wasi {
                self.load_module(fid, 0, Str.empty(), "std/sys/memory")
            }
            runtime := if wasi and db.native_executable { "std/sys/start" } else {
                "std/sys/process"
            }
            self.load_module(fid, 0, Str.empty(), runtime)
        }
        fid
    }

    dump_air :: fn(self &Self, path, source, name Str) {
        file := self.add_file(path, source)
        db := &self.nexus
        if name.len != 0 {
            symbol := db.find_local_symbol(file, db.interner.intern(name))
            self.ensure_resolved(symbol)
            if db.get_fn_node(symbol) == id_none() {
                printf("[air error] function '{}' not found\n", .(name))
                #fall
            }
            tyck.process_mono_funcs(self)
            module := air_lower.lower(db, self.arena, file, id_none(), symbol)
            if module.air_single() {
                keel.dump(name, module.functions.ptr_at(0))
            } else {
                keel.dump_program(&module)
            }
            module.destroy()
        } else {
            main := db.find_local_symbol(file, db.interner.intern("main"))
            entry := self.build_entry(file, main != id_none())
            module := air_lower.lower(db, self.arena, file, entry, id_none())
            keel.dump_program(&module)
            module.destroy()
        }
    }

    type_check :: fn(self &Self, sym_id u32) {
        timing := profile.enter(Phase.type_check)
        self.type_check_impl(sym_id)
        profile.leave(timing)
    }

    type_check_impl :: fn(self &Self, sym_id u32) {
        hir_start := self.nexus.sym_hir_start(sym_id)
        hir_end := self.nexus.sym_hir_end(sym_id)
        dirty_mark := self.nexus.unify.dirty_mark()

        tyck.type_check(self, hir_start, hir_end)
        global := self.nexus.global_var(sym_id)
        if global != hir.hir_none() {
            timing := profile.enter(Phase.type_check_globals)
            check_global_var(self, global)
            profile.leave(timing)
        }
        fn_node := self.nexus.get_fn_node(sym_id)
        if fn_node != id_none() {
            tyck.finalize_inferred_types_range(self, fn_node, dirty_mark)
        }
        self.nexus.unify.truncate_dirty(dirty_mark)
    }

    predeclare_nominal :: fn(self &Self, sym_id u32) {
        db := &self.nexus
        decl_hir := db.get_sym_hir(sym_id)
        if decl_hir == id_none() {
            ret
        }
        hir_end := db.sym_hir_end(sym_id)
        if (hir_end == id_none()) or (hir_end == 0) {
            ret
        }
        root := hir_end - 1
        if db.hir.kind(root) != hir.hir_kind.binding {
            ret
        }
        value_node := db.hir.extra(root)
        kind := db.hir.kind(value_node)
        if kind != hir.hir_kind.struct_ and kind != hir.hir_kind.nominal_tuple {
            ret
        }
        existing := db.get_const_type(decl_hir)
        if existing != type_defs.ty_id_none() {
            ret
        }
        name_id := db.sym_name(sym_id)
        name := db.interner.get(name_id)
        named := db.types.alloc_nominal(type_defs.ty_id_none(), name, value_node)

        db.set_const_type(value_node, named)
        db.set_const_type(decl_hir, named)
        db.set_is_const(decl_hir, true)
        db.set_sym_is_const(sym_id, true)

        slot := (&db.unify).get_slot(decl_hir)
        if slot == slot_none() {
            slot = (&db.unify).new_slot(decl_hir)
        }
        (&db.unify).bind_type(&db.types, slot, type_defs.ty_id_type())
    }

    ensure_resolved :: fn(self &Self, sym_id u32) {
        if sym_id == id_none() {
            ret
        }
        db := &self.nexus

        real_sym := db.resolve_sym(sym_id)

        tok_start := db.sym_tok_start(real_sym)
        if tok_start == id_none() {
            ret
        }
        decl_hir := db.get_sym_hir(real_sym)
        if decl_hir != id_none() {
            s := (&db.unify).get_slot(decl_hir)
            if s != slot_none() {
                ty := (&db.unify).resolve_type(s)
                if ty != type_defs.ty_id_none() {
                    ret
                }
            }
        }
        if db.is_sym_resolving(real_sym) {
            ret
        }
        timing := profile.enter(Phase.type_resolve)
        if decl_hir != id_none() {
            s := (&db.unify).get_slot(decl_hir)
            if s == slot_none() {
                (&db.unify).new_slot(decl_hir)
            }
        }
        self.predeclare_nominal(real_sym)

        db.set_sym_resolving(real_sym, true)
        self.type_check(real_sym)
        db.set_sym_resolving(real_sym, false)
        profile.leave(timing)
    }

    slot_of :: fn(self &Self, sym_id u32) u32 {
        if sym_id == id_none() {
            ret slot_none()
        }
        db := &self.nexus

        real_sym := db.resolve_sym(sym_id)

        tok_start := db.sym_tok_start(real_sym)
        if tok_start == id_none() {
            decl_hir := db.get_sym_hir(real_sym)
            if decl_hir == id_none() {
                ret slot_none()
            }
            ret (&db.unify).get_slot(decl_hir)
        }
        self.ensure_resolved(real_sym)
        decl_hir := db.get_sym_hir(real_sym)
        if decl_hir == id_none() {
            ret slot_none()
        }
        (&db.unify).get_slot(decl_hir)
    }

    type_of :: fn(self &Self, sym_id u32) u32 {
        slot := self.slot_of(sym_id)
        if slot == slot_none() {
            ret type_defs.ty_id_none()
        }
        (&self.nexus.unify).resolve_type(slot)
    }

    get_str_type :: fn(self &Self) u32 {
        db := &self.nexus
        if (*db).str_type != type_defs.ty_id_none() {
            ret (*db).str_type
        }
        if (*db).core_prelude == id_none() {
            ret type_defs.ty_id_none()
        }
        name_id := (*db).interner.intern(Str.of("Str"))
        sym_str := (*db).find_symbol((*db).core_prelude, name_id)
        if sym_str == id_none() {
            ret type_defs.ty_id_none()
        }
        self.ensure_resolved(sym_str)
        real_sym := (*db).resolve_sym(sym_str)
        decl_hir := (*db).get_sym_hir(real_sym)
        if decl_hir != id_none() {
            str_ty := (*db).get_const_type(decl_hir)
            (*db).str_type = str_ty
            ret str_ty
        }
        type_defs.ty_id_none()
    }

    validate_main :: fn(self &Self, sym_id u32) {
        ty := self.type_of(sym_id)
        types := &self.nexus.types
        if types.kind(ty) != type_defs.TyKind.func {
            print("\n[type error] main must be a function")
            #fall
        }
        if ((&(*types)).func_params_len(ty) != 0) or (&(*types)).func_is_extern(ty) {
            print("\n[type error] main must be a defined function with no arguments")
            #fall
        }
        result := types.func_return(ty)
        if types.kind(result) != type_defs.TyKind.unit and result != types.alloc_int(32) {
            print("\n[type error] main must return i32 or no value")
            #fall
        }
    }

    build_main :: fn(self &Self, fid u32) u32 {
        self.build_entry(fid, true)
    }

    build_entry :: fn(self &Self, fid u32, executable bool) u32 {
        timing := profile.enter(Phase.type_resolve)
        result := self.build_entry_impl(fid, executable)
        profile.leave(timing)
        result
    }

    build_entry_impl :: fn(self &Self, fid u32, executable bool) u32 {
        sym_id := id_none()
        if executable {
            sym_id = self.nexus.find_local_symbol(fid, self.nexus.interner.intern("main"))
            if sym_id == id_none() {
                print("\n[syntax error] symbol not found")
                #fall
            }
            global := self.nexus.global_var(sym_id)
            if global != hir.hir_none() {
                self.nexus.type_error(global, "main must be a function declaration")
            }
            self.ensure_resolved(sym_id)
            self.validate_main(sym_id)
            sym_id = self.nexus.resolve_sym(sym_id)
        }

        exports := HashMap(u32, u32).new()
        index: u32 = 0
        while true {
            if index == self.nexus.sym_count() {
                tyck.process_mono_funcs(self)
                if index == self.nexus.sym_count() { break }
            }
            i := index
            index = index + 1
            if self.nexus.sym_tok_start(i) == id_none() or self.nexus.resolve_sym(i) != i {
                cont
            }
            node := self.nexus.get_fn_node(i)
            exported := node != id_none() and self.nexus.is_extern_fn(node) and
                self.nexus.hir.extra(node) != hir.hir_none()
            if self.nexus.sym_file(i) != fid and self.nexus.global_var(i) == hir.hir_none() and
                not exported {
                cont
            }
            self.ensure_resolved(i)
            if node == id_none() or not self.nexus.is_extern_fn(node) or
                self.nexus.hir.extra(node) == hir.hir_none() {
                cont
            }
            name := self.nexus.extern_link_name(i, node)
            if executable and self.nexus.interner.get(name).eq("main") {
                self.nexus.type_error(
                    node
                    "the C symbol 'main' is reserved for the program entry point"
                )
            }
            if exports.get(name) != (0 as &u32) {
                self.nexus.type_error(node, "duplicate exported C symbol")
            }
            exports.insert(name, i)
        }
        exports.destroy()

        sym_id
    }

    compile_vm :: fn(self &Self, backend &VmCodeGen, builder &VmCodeBuilder, sym_id u32) {
        lower_function(&self.nexus, backend, builder, self.arena, sym_id)
    }
}
