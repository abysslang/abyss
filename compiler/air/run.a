ir :: @import("./ir")
fall :: @import("std/sys").fall

transfer :: fn(regs, scratch &u32, base u64, args Slice(u32)) {
    if args.len == 0 { ret }
    if args.len == 1 {
        regs[base] = regs[args.get(0) as u64]
        ret
    }
    pos: u64 = 0
    for arg in args {
        scratch[pos] = regs[arg as u64]
        pos = pos + 1
    }
    pos = 0
    while pos < args.len {
        regs[base + pos] = scratch[pos]
        pos = pos + 1
    }
}

run :: fn(func &ir.Function, input Slice(u32)) u32 {
    if func.block_start.len == 0 or func.current.is_some() { #fall }
    block: ir.Block = .{ index: 0 }
    if func.block_end.get(0) == 0 or input.len != func.parameters(block).len { #fall }
    capacity := func.types.len + func.max_edge_args
    frame := Vec(u32).with_cap(capacity)
    while frame.len < capacity { frame.push(0) }
    regs := frame.ptr
    scratch := regs + func.types.len
    base := func.value_start.get(0) as u64
    pos: u64 = 0
    for value in input {
        regs[base + pos] = value
        pos = pos + 1
    }
    dest := base + input.len
    while true {
        range := func.range(block)
        if range.end == 0 { #fall }
        at := range.start as u64
        while func.ops.get(at) == ir.Op.iadd {
            word := func.starts.get(at) as u64
            lhs := regs[func.pool.get(word) as u64] as u64
            rhs := regs[func.pool.get(word + 1) as u64] as u64
            regs[dest] = (lhs + rhs) as u32
            at = at + 1
            dest = dest + 1
        }
        word := func.starts.get(at) as u64
        token := func.pool.get(word)
        op := func.ops.get(at)
        if op == ir.Op.ret_ {
            value := regs[token as u64]
            frame.destroy()
            ret value
        }
        edge := token as u64
        if op == ir.Op.branch {
            edge = func.pool.get(word + 1) as u64
            if regs[token as u64] == 0 { edge = edge + 1 }
        }
        block.index = func.edge_targets.get(edge)
        args := func.arguments(edge)
        base = func.value_start.get(block.index as u64) as u64
        transfer(regs, scratch, base, args)
        dest = base + args.len
    }
    0
}
