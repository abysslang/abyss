profile :: @import("pods/keel/profile")
Phase :: profile.Phase
HirExprKind :: hir.HirExprKind
Program :: keel.Program
keel :: @import("pods/keel")
opt :: @import("pods/keel/opt/pipeline")
Arch :: @import("core/target").Arch
hir :: @import("compiler/hir")
storage :: @import("./layout")
Shape :: storage.Shape
Field :: storage.Field
LayoutCache :: storage.LayoutCache
abi :: @import("./abi")
AbiField :: @import("pods/keel/abi_types").Field
types :: @import("compiler/types")
Nexus :: @import("compiler/nexus/nexus").Nexus
String :: @import("std/string").String
Arena :: @import("std/allocator").Arena
mem :: @import("std/mem")
legacy :: @import("compiler/lower")
parse_float :: @import("compiler/vm/codegen").parse_float
vm :: @import("compiler/vm/codegen")
func_has_self :: @import("compiler/typer/fn").func_has_self
reflection :: @import("compiler/typer/reflection")
k :: hir.hir_kind
Kind :: types.TyKind
Ty :: keel.Ty
Op :: keel.Op
Val :: keel.Val
Block :: keel.Block
Symbol :: keel.Symbol
none :: @import("compiler/hir").hir_none

Pending :: struct {
    source u32
    target Symbol
}

Metadata :: struct {
    source          u64
    ty, count, node u32
    target          Symbol
}

Lit :: struct {
    symbol Symbol
    len    u64
}

Module :: struct {
    db               &Nexus
    arena            &Arena
    air              Program
    symbols          Vec(Symbol)
    strings          Vec(Symbol)
    literals         Vec(Lit)
    pending          Vec(Pending)
    globals          Vec(Pending)
    metadata         Vec(Metadata)
    reflected        HashMap(u64, Symbol)
    layout           LayoutCache
    abi_types        Vec(u32)
    abi_layouts      Vec(u8)
    abi_scratch      Vec(AbiField)
    locals           Vec(Val)
    local_kinds      Vec(u8)
    local_dirty      Vec(u32)
    init_locals      Vec(Val)
    init_kinds       Vec(u8)
    init_dirty       Vec(u32)
    heap             HeapHooks
    sym_ptr_name     u32
    sym_len_name     u32
    sym_index_name   u32
    sym_present_name u32
    sym_value_name   u32
    sym_fields_name  u32
    sym_members_name u32
    sym_params_name  u32
    new :: fn(db &Nexus, arena &Arena) Self {
        sym_cap := db.sym_count() as u64 + 16
        ty_cap := db.types.kinds.len + 16
        str_cap := db.interner.strings.len + 64
        lit_cap := (db.interner.strings.len + 16) * 2
        symbols := Vec(Symbol).with_cap(sym_cap)
        symbols.len = sym_cap
        mem.mem_set(symbols.ptr as &u8, 0, sym_cap * @sizeof(Symbol))
        strings := Vec(Symbol).with_cap(str_cap)
        strings.len = str_cap
        mem.mem_set(strings.ptr as &u8, 0, str_cap * @sizeof(Symbol))
        literals := Vec(Lit).with_cap(lit_cap)
        literals.len = lit_cap
        mem.mem_set(literals.ptr as &u8, 0, lit_cap * @sizeof(Lit))
        abi_types := Vec(u32).with_cap(ty_cap)
        abi_types.len = ty_cap
        mem.mem_set(abi_types.ptr as &u8, 0, ty_cap * @sizeof(u32))
        abi_layouts := Vec(u8).with_cap(ty_cap)
        abi_layouts.len = ty_cap
        mem.mem_set(abi_layouts.ptr as &u8, 0, ty_cap)
        locals := Vec(Val).with_cap(sym_cap)
        locals.len = sym_cap
        mem.mem_set(locals.ptr as &u8, 0, sym_cap * @sizeof(Val))
        local_kinds := Vec(u8).with_cap(sym_cap)
        local_kinds.len = sym_cap
        mem.mem_set(local_kinds.ptr as &u8, 0, sym_cap)
        .{
            db: db
            arena: arena
            air: Program.new()
            symbols: symbols
            strings: strings
            literals: literals
            pending: Vec(Pending).new()
            globals: Vec(Pending).new()
            metadata: Vec(Metadata).new()
            reflected: HashMap(u64, Symbol).new()
            layout: LayoutCache.new(db.types.kinds.len)
            abi_types: abi_types
            abi_layouts: abi_layouts
            abi_scratch: Vec(AbiField).new()
            locals: locals
            local_kinds: local_kinds
            local_dirty: Vec(u32).new()
            init_locals: Vec(Val).empty()
            init_kinds: Vec(u8).empty()
            init_dirty: Vec(u32).empty()
            heap: HeapHooks.find(db)
            sym_ptr_name: db.interner.intern("ptr")
            sym_len_name: db.interner.intern("len")
            sym_index_name: db.interner.intern("index")
            sym_present_name: db.interner.intern("present")
            sym_value_name: db.interner.intern("value")
            sym_fields_name: db.interner.intern("fields")
            sym_members_name: db.interner.intern("members")
            sym_params_name: db.interner.intern("params")
        }
    }

    destroy_scratch :: fn(self &Self) {
        self.symbols.destroy()
        self.strings.destroy()
        self.literals.destroy()
        self.pending.destroy()
        self.globals.destroy()
        self.metadata.destroy()
        self.reflected.destroy()
        self.layout.destroy()
        self.abi_types.destroy()
        self.abi_layouts.destroy()
        self.abi_scratch.destroy()
        self.locals.destroy()
        self.local_kinds.destroy()
        self.local_dirty.destroy()
        self.init_locals.destroy()
        self.init_kinds.destroy()
        self.init_dirty.destroy()
    }

    ensure_symbol_slot :: fn(self &Self, sym u32) {
        idx := sym as u64
        if idx < self.symbols.len { ret }
        old := self.symbols.len
        new_len := idx + 16
        self.symbols.reserve(new_len)
        self.symbols.len = new_len
        mem.mem_set((self.symbols.ptr + old) as &u8, 0, (new_len - old) * @sizeof(Symbol))
    }

    ensure_string_slot :: fn(self &Self, key u32) {
        idx := key as u64
        if idx < self.strings.len { ret }
        old := self.strings.len
        new_len := idx + 64
        self.strings.reserve(new_len)
        self.strings.len = new_len
        mem.mem_set((self.strings.ptr + old) as &u8, 0, (new_len - old) * @sizeof(Symbol))
    }

    ensure_literal_slot :: fn(self &Self, idx u64) {
        if idx < self.literals.len { ret }
        old := self.literals.len
        new_len := idx + 32
        self.literals.reserve(new_len)
        self.literals.len = new_len
        mem.mem_set((self.literals.ptr + old) as &u8, 0, (new_len - old) * @sizeof(Lit))
    }

    intern_data :: fn(self &Self, bytes Str) Symbol {
        key := self.db.interner.intern(bytes)
        self.ensure_string_slot(key)
        sym := self.strings.get(key as u64)
        if sym != Symbol.none { ret sym }
        added := self.air.data(self.db.interner.get(key))
        self.strings.set(key as u64, added)
        added
    }

    abi_type :: fn(self &Self, ty, node u32) u32 {
        abi.lower(self.db, &self.air, &self.abi_types, &self.abi_scratch, ty, node)
    }

    native_layout :: fn(self &Self, ty u32) bool {
        abi.dependent(self.db, &self.abi_layouts, ty)
    }

    shape :: fn(self &Self, ty, node u32) Shape {
        self.layout.shape(self.db, ty, node)
    }

    field :: fn(self &Self, ty, name, node u32) Field {
        self.layout.field(self.db, ty, name, node, self.native_layout(ty))
    }

    union_offset :: fn(self &Self, ty, node u32) u32 {
        self.layout.union_align(self.db, ty, node)
    }

    is_packed :: fn(self &Self, ty, node u32) bool {
        self.layout.is_packed(self.db, ty, node, self.native_layout(ty))
    }

    function_address :: fn(self &Self, sym, node u32) Symbol {
        key := self.register(sym, node)
        decl := self.air.declarations.ptr_at(key as u64 - 1)
        if decl.abi_signature == 0 {
            decl.abi_signature = self.abi_type(
                func_type(self.db, sym, self.db.get_fn_node(sym))
                node
            )
        }
        key
    }

    reflect :: fn(self &Self, source u64, ty, count, node u32) Symbol {
        found := self.reflected.get(source)
        if found != (0 as &Symbol) { ret *found }
        shape := self.shape(ty, node)
        size := shape.size * (if count == 0 { 1 as u32 } else { count })
        target := self.air.global("$typeinfo", size, shape.align)
        self.reflected.insert(source, target)
        self.metadata.push(.{ source: source, ty: ty, count: count, node: node, target: target })
        target
    }

    register :: fn(self &Self, sym, node u32) Symbol {
        db := self.db
        real := db.resolve_sym(sym)
        self.ensure_symbol_slot(real)
        cached := self.symbols.get(real as u64)
        if cached != Symbol.none { ret cached }
        replacement := self.heap.replacement(db, real)
        if replacement != none() {
            key := self.register(replacement, node)
            self.symbols.set(real as u64, key)
            ret key
        }
        global := db.global_var(real)
        if global != none() {
            ty := db.get_node_type(db.hir.lhs(global))
            name := db.interner.get(db.sym_name(real))
            key := if self.native_layout(ty) {
                self.air.typed_global(name, self.abi_type(ty, global))
            } else {
                shape := self.shape(ty, global)
                self.air.global(name, shape.size, shape.align)
            }
            self.symbols.set(real as u64, key)
            if db.hir.extra(global) != none() {
                self.globals.push(.{ source: global, target: key })
            }
            ret key
        }
        func := db.get_fn_node(real)
        if func == none() { storage.error(db, node, "unresolved function or global") }
        signature := func_type(db, real, func)
        if db.types.kind(signature) != Kind.func {
            storage.error(db, func, "function has no resolved signature")
        }
        result := db.types.func_return(signature)
        external := db.is_extern_fn(func) and db.hir.extra(func) == none()
        args := db.types.func_params(signature)
        need := args.len + (if storage.aggregate(db, result) { 1 as u64 } else { 0 as u64 })
        name := if db.is_extern_fn(func) { db.extern_link_name(real, func) } else {
            db.sym_name(real)
        }
        output := if storage.aggregate(db, result) { Ty.void_ } else {
            storage.scalar(db, result, func)
        }
        key := if need > 16 {
            heap_params := Vec(Ty).with_cap(need)
            if storage.aggregate(db, result) { heap_params.push(Ty.ptr) }
            position: u64 = 0
            while position < args.len {
                ty := args.get(position)
                if runtime_arg(db, func, position, ty) {
                    heap_params.push(storage.scalar(db, ty, func))
                }
                position = position + 1
            }
            k := self.air.declare(db.interner.get(name), heap_params.as_slice(), output, external)
            heap_params.destroy()
            k
        } else {
            stack_params: [16]Ty
            param_count: u64 = 0
            if storage.aggregate(db, result) {
                stack_params[0] = Ty.ptr
                param_count = 1
            }
            position: u64 = 0
            while position < args.len {
                ty := args.get(position)
                if runtime_arg(db, func, position, ty) {
                    stack_params[param_count] = storage.scalar(db, ty, func)
                    param_count = param_count + 1
                }
                position = position + 1
            }
            params_slice := if param_count == 0 {
                Slice(Ty).empty()
            } else {
                Slice(Ty).new(&stack_params[0], param_count)
            }
            self.air.declare(db.interner.get(name), params_slice, output, external)
        }
        decl := self.air.declarations.ptr_at(key as u64 - 1)
        decl.exported = db.is_extern_fn(func) and not external
        decl.foreign_module = db.extern_module(func)
        decl.header = db.extern_header(func)
        if decl.header.len != 0 { abi.require_headers(db, func) }
        if external or decl.exported { decl.abi_signature = self.abi_type(signature, func) }
        self.symbols.set(real as u64, key)
        if not external { self.pending.push(.{ source: real, target: key }) }
        key
    }
}

HeapHooks :: struct {
    source, malloc, realloc u32

    find :: fn(db &Nexus) Self {
        hooks: Self = .{ source: none(), malloc: none(), realloc: none() }
        driver := none()
        for index in Range.new(0, db.file_paths.len as i32) {
            path := db.get_file_path(index as u32)
            if path.eq("std/mem.a") { hooks.source = index as u32 }
            if path.eq("compiler/driver.a") or path.ends_with("/compiler/driver.a") {
                driver = index as u32
            }
        }
        if driver != none() {
            hooks.malloc = db.find_local_symbol(driver, db.interner.intern("profile_malloc"))
            hooks.realloc = db.find_local_symbol(driver, db.interner.intern("profile_realloc"))
        }
        hooks
    }

    replacement :: fn(self &Self, db &Nexus, sym u32) u32 {
        if self.malloc == none() or self.realloc == none() or db.sym_file(sym) != self.source {
            ret none()
        }
        name := db.interner.get(db.sym_name(sym))
        if name.eq("malloc") { ret self.malloc }
        if name.eq("realloc") { ret self.realloc }
        none()
    }
}

func_type :: fn(db &Nexus, sym, func u32) u32 {
    if db.is_mono_sym(sym) { ret db.get_mono_type(sym) }
    db.get_node_type(func)
}

items :: fn(db &Nexus, list u32) Slice(u32) {
    if list == none() { ret Slice(u32).empty() }
    db.get_list(list)
}

runtime_arg :: fn(db &Nexus, func u32, position u64, ty u32) bool {
    if ty == types.ty_id_type() { ret false }
    if func == none() { ret true }
    args := items(db, db.hir.lhs(func))
    if position >= args.len { ret true }
    arg := args.get(position)
    annotation := db.hir.rhs(arg)
    if db.hir.extra(arg) == 1 or db.get_const_type(annotation) == types.ty_id_type() { ret false }
    annotation == none() or db.hir.kind(annotation) != k.ident or
        not db.interner.get(db.hir.lhs(annotation)).eq("type")
}

Context :: struct {
    module                &Module
    db                    &Nexus
    out                   keel.Function
    locals                &Vec(Val)
    local_kinds           &Vec(u8)
    local_dirty           &Vec(u32)
    break_to, continue_to Block
    return_ty             u32
    return_slot           Val

    new :: fn(
        module &Module
        result u32
        locals &Vec(Val)
        local_kinds &Vec(u8)
        local_dirty &Vec(u32)
    ) Self {
        for sym in *local_dirty {
            locals.set(sym as u64, Val.none)
            local_kinds.set(sym as u64, 0)
        }
        local_dirty.clear()
        .{
            module: module
            db: module.db
            out: keel.Function.new()
            locals: locals
            local_kinds: local_kinds
            local_dirty: local_dirty
            break_to: Block.none
            continue_to: Block.none
            return_ty: result
            return_slot: Val.none
        }
    }

    open :: fn(self &Self) bool {
        self.out.current != Block.none
    }

    ensure_local_cap :: fn(self &Self, idx u64) {
        if idx < self.locals.len { ret }
        old := self.locals.len
        new_len := idx + 16
        grow := new_len - old
        self.locals.reserve(grow)
        self.locals.len = new_len
        mem.mem_set((self.locals.ptr + old) as &u8, 0, grow * @sizeof(Val))
        self.local_kinds.reserve(grow)
        self.local_kinds.len = new_len
        mem.mem_set(self.local_kinds.ptr + old, 0, grow)
    }

    mark_need_slot :: fn(self &Self, sym u32) {
        if sym == none() { ret }
        idx := sym as u64
        self.ensure_local_cap(idx)
        if self.local_kinds.get(idx) == 0 {
            self.local_dirty.push(sym)
            self.local_kinds.set(idx, 3)
        }
    }

    needs_slot :: fn(self &Self, sym u32) bool {
        if sym == none() or sym as u64 >= self.local_kinds.len { ret false }
        self.local_kinds.get(sym as u64) == 3
    }

    bind_local :: fn(self &Self, sym u32, slot Val) {
        idx := sym as u64
        self.ensure_local_cap(idx)
        if self.local_kinds.get(idx) == 0 { self.local_dirty.push(sym) }
        self.locals.set(idx, slot)
        self.local_kinds.set(idx, 1)
    }

    bind_val :: fn(self &Self, sym u32, value Val) {
        idx := sym as u64
        self.ensure_local_cap(idx)
        if self.local_kinds.get(idx) == 0 { self.local_dirty.push(sym) }
        self.locals.set(idx, value)
        self.local_kinds.set(idx, 2)
    }

    find_local :: fn(self &Self, sym u32) Val {
        if sym == none() or sym as u64 >= self.locals.len { ret Val.none }
        if self.local_kinds.get(sym as u64) != 1 { ret Val.none }
        self.locals.get(sym as u64)
    }

    find_val :: fn(self &Self, sym u32) Val {
        if sym == none() or sym as u64 >= self.locals.len { ret Val.none }
        if self.local_kinds.get(sym as u64) != 2 { ret Val.none }
        self.locals.get(sym as u64)
    }

    has_local :: fn(self &Self, sym u32) bool {
        if sym == none() or sym as u64 >= self.local_kinds.len { ret false }
        kind := self.local_kinds.get(sym as u64)
        kind == 1 or kind == 2
    }

    offset :: fn(self &Self, base Val, bytes u32) Val {
        if bytes == 0 { ret base }
        index := self.out.constant(Ty.u32_, bytes as u64)
        self.out.offset(base, index, 1)
    }

    slot :: fn(self &Self, ty, node u32) Val {
        if self.module.native_layout(ty) {
            ret self.out.stack_layout(self.module.abi_type(ty, node))
        }
        shape := self.module.shape(ty, node)
        self.out.stack(shape.size, shape.align)
    }

    size :: fn(self &Self, ty, node u32) Val {
        if self.module.native_layout(ty) {
            ret self.out.size_of(self.module.abi_type(ty, node))
        }
        self.out.constant(Ty.u64_, self.module.shape(ty, node).size as u64)
    }

    copy :: fn(self &Self, ty, node u32, dest, value Val) {
        if dest == value { ret }
        if self.module.native_layout(ty) {
            self.out.copy_bytes(dest, value, self.size(ty, node))
        } else {
            size := self.module.shape(ty, node).size
            if size != 0 { self.out.copy(dest, value, size) }
        }
    }

    zero :: fn(self &Self, ty, node u32, dest Val) {
        if self.module.native_layout(ty) {
            self.out.zero_layout(dest, self.module.abi_type(ty, node))
        } else {
            size := self.module.shape(ty, node).size
            if size != 0 { self.out.zero(dest, size) }
        }
    }

    element :: fn(self &Self, base, index Val, ty, node u32) Val {
        if self.module.native_layout(ty) {
            offset := self.out.binary(Op.mul, self.out.cast(Ty.u64_, index), self.size(ty, node))
            ret self.out.offset(base, offset, 1)
        }
        self.out.offset(base, index, self.module.shape(ty, node).size)
    }

    field :: fn(self &Self, ty, name, node u32) Field {
        self.module.field(ty, name, node)
    }

    union_payload :: fn(self &Self, base Val, ty, node u32) Val {
        if self.module.native_layout(ty) {
            field := self.out.field_offset(self.module.abi_type(ty, node), 0, 2)
            ret self.out.offset(base, field, 1)
        }
        self.offset(base, self.module.union_offset(ty, node))
    }

    read :: fn(self &Self, ty, node u32, address, dest Val) Val {
        if storage.aggregate(self.db, ty) {
            value := if dest != Val.none { dest } else { self.slot(ty, node) }
            self.copy(ty, node, value, address)
            ret value
        }
        self.out.load(storage.scalar(self.db, ty, node), address)
    }

    write :: fn(self &Self, ty, node u32, address, value Val) {
        if storage.aggregate(self.db, ty) {
            self.copy(ty, node, address, value)
        } else {
            self.out.store(address, self.out.cast(storage.scalar(self.db, ty, node), value))
        }
    }

    fit :: fn(self &Self, val Val, ty, node u32, dest Val) Val {
        if dest == Val.none or val == Val.none or not storage.aggregate(self.db, ty) { ret val }
        self.copy(ty, node, dest, val)
        dest
    }

    local :: fn(self &Self, name, ty u32, value Val) {
        sym := self.db.get_hir_symbol(name)
        if not self.needs_slot(sym) and not storage.aggregate(self.db, ty) {
            scalar := storage.scalar(self.db, ty, name)
            if scalar == Ty.void_ { ret }
            bound := if value != Val.none {
                self.out.cast(scalar, value)
            } else {
                self.out.constant(scalar, 0)
            }
            self.bind_val(sym, bound)
            ret
        }
        address := self.slot(ty, name)
        self.bind_local(sym, address)
        if value != Val.none {
            self.write(ty, name, address, value)
        } else if storage.aggregate(self.db, ty) {
            self.zero(ty, name, address)
        } else {
            scalar := storage.scalar(self.db, ty, name)
            if scalar != Ty.void_ { self.out.store(address, self.out.constant(scalar, 0)) }
        }
    }

    finish :: fn(self &Self, value Val, node u32) {
        if not self.open() { ret }
        if self.return_slot != Val.none {
            self.write(self.return_ty, node, self.return_slot, value)
            self.out.ret_void()
        } else if self.return_ty == types.ty_id_unit() {
            self.out.ret_void()
        } else if self.return_ty == types.ty_id_never() {
            self.out.trap()
        } else {
            if value == Val.none { storage.error(self.db, node, "missing return value") }
            self.out.ret_value(self.out.cast(storage.scalar(self.db, self.return_ty, node), value))
        }
    }
}

jump_to :: fn(ctx &Context, target Block, ty Ty, value Val) {
    if not ctx.open() { ret }
    if ty == Ty.void_ { ctx.out.jump(target) } else {
        ctx.out.jump_value(target, ctx.out.cast(ty, value))
    }
}

join :: fn(ctx &Context, ty Ty) Block {
    if ty == Ty.void_ { ret ctx.out.block() }
    ctx.out.block_with_param(ty)
}

open_join :: fn(ctx &Context, block Block, ty Ty) Val {
    ctx.out.begin(block)
    if ty != Ty.void_ { ret ctx.out.parameter(block, 0) }
    Val.none
}

into :: fn(ctx &Context, node, want_ty u32, dest Val) {
    if storage.aggregate(ctx.db, want_ty) {
        val := expr_into(ctx, node, dest)
        if ctx.open() and val != dest and val != Val.none {
            ctx.copy(want_ty, node, dest, val)
        }
        ret
    }
    val := expr(ctx, node)
    if ctx.open() { ctx.write(want_ty, node, dest, val) }
}

quiet :: fn(ctx &Context, node, except_sym u32) bool {
    if node == none() { ret false }
    db := ctx.db
    table := &db.hir
    match table.kind(node) {
        lit_bool_true, lit_bool_false, lit_int, lit_float, lit_char, lit_str, lit_cstr {
            ret true
        }
        ident {
            sym := db.get_hir_symbol(node)
            ret sym != except_sym and ctx.has_local(sym) and
                not storage.aggregate(db, db.get_node_type(node))
        }
        struct_init {
            for item in items(db, table.rhs(node)) {
                if not quiet(ctx, item, except_sym) { ret false }
            }
            ret true
        }
        array_init {
            for item in items(db, table.lhs(node)) {
                if not quiet(ctx, item, except_sym) { ret false }
            }
            ret true
        }
        else { ret false }
    }
}

conditional :: fn(ctx &Context, node, left, right, extra u32, dest Val) Val {
    result_ty := ctx.db.get_node_type(node)
    has_else := extra != none() and result_ty != types.ty_id_none()
    is_agg := has_else and storage.aggregate(ctx.db, result_ty)
    agg_dest := if is_agg {
        if dest != Val.none { dest } else { ctx.slot(result_ty, node) }
    } else {
        Val.none
    }
    ty := if not has_else or is_agg { Ty.void_ } else {
        storage.scalar(ctx.db, result_ty, node)
    }
    cond := expr(ctx, left)
    if not ctx.open() { ret Val.none }
    yes := ctx.out.block()
    no := ctx.out.block()
    end := join(ctx, ty)
    ctx.out.branch(cond, yes, no)
    ctx.out.begin(yes)
    on_yes := expr_into(ctx, right, agg_dest)
    if ctx.open() and is_agg and on_yes != agg_dest and on_yes != Val.none {
        ctx.copy(result_ty, node, agg_dest, on_yes)
    }
    yes_open := ctx.open()
    jump_to(ctx, end, ty, on_yes)
    ctx.out.begin(no)
    on_no := expr_into(ctx, extra, agg_dest)
    if ctx.open() and is_agg and on_no != agg_dest and on_no != Val.none {
        ctx.copy(result_ty, node, agg_dest, on_no)
    }
    no_open := ctx.open()
    jump_to(ctx, end, ty, on_no)
    result := open_join(ctx, end, ty)
    if not yes_open and not no_open {
        ctx.out.trap()
        ret Val.none
    }
    if is_agg { ret agg_dest }
    result
}

logical :: fn(ctx &Context, kind HirExprKind, left, right u32) Val {
    lhs := expr(ctx, left)
    if not ctx.open() { ret Val.none }
    rhs := ctx.out.block()
    end := join(ctx, Ty.i1)
    pass := Slice(Val).new(&lhs, 1)
    empty := Slice(Val).empty()
    if kind == k.binary_and {
        ctx.out.branch_with_args(lhs, rhs, empty, end, pass)
    } else {
        ctx.out.branch_with_args(lhs, end, pass, rhs, empty)
    }
    ctx.out.begin(rhs)
    value := expr(ctx, right)
    jump_to(ctx, end, Ty.i1, value)
    open_join(ctx, end, Ty.i1)
}

while_loop :: fn(ctx &Context, cond, body u32) {
    head := ctx.out.block()
    end := ctx.out.block()
    saved := .(ctx.break_to, ctx.continue_to)
    ctx.break_to = end
    ctx.continue_to = head
    ctx.out.jump(head)
    ctx.out.begin(head)
    test := expr(ctx, cond)
    if ctx.open() {
        run := ctx.out.block()
        ctx.out.branch(test, run, end)
        ctx.out.begin(run)
        expr(ctx, body)
        jump_to(ctx, head, Ty.void_, Val.none)
    }
    ctx.break_to = saved.0
    ctx.continue_to = saved.1
    ctx.out.begin(end)
}

binary_op :: fn(kind HirExprKind) Op {
    match kind {
        binary_add { Op.iadd }
        binary_sub { Op.sub }
        binary_mul { Op.mul }
        binary_div { Op.div }
        binary_mod { Op.rem }
        binary_eq_eq { Op.eq }
        binary_neq { Op.ne }
        binary_lt { Op.lt }
        binary_lt_eq { Op.le }
        binary_gt { Op.gt }
        binary_gt_eq { Op.ge }
        binary_bit_and { Op.band }
        binary_bit_or { Op.bor }
        binary_bit_xor { Op.bxor }
        binary_shl { Op.shl }
        binary_shr { Op.shr }
        else { Op.trap }
    }
}

binary_expr :: fn(ctx &Context, node, left, right u32) Val {
    db := ctx.db
    op := binary_op(db.hir.kind(node))
    lhs := expr(ctx, left)
    rhs := expr(ctx, right)
    if not ctx.open() { ret Val.none }
    ty := ctx.out.value_type(lhs)
    if ty == Ty.ptr and (op == Op.iadd or op == Op.sub) {
        elem := db.types.payload(db.get_node_type(left))
        index := if op == Op.sub { ctx.out.unary(Op.neg, rhs) } else { rhs }
        ret ctx.element(lhs, index, elem, node)
    }
    rhs_ty := ctx.out.value_type(rhs)
    if ty != rhs_ty and
        (
            db.get_node_type(left) == types.ty_id_untyped_int() or
                db.get_node_type(left) == types.ty_id_untyped_float()
        ) {
        lhs = ctx.out.cast(rhs_ty, lhs)
        ty = rhs_ty
    }
    ctx.out.binary(op, lhs, ctx.out.cast(ty, rhs))
}

number :: fn(ctx &Context, ty Ty, value f64) Val {
    if ty == Ty.f32_ {
        narrow := value as f32
        bits: u32 = 0
        @memcpy(&bits as &u8, &narrow as &u8, 4)
        ret ctx.out.constant(ty, bits as u64)
    }
    bits: u64 = 0
    @memcpy(&bits as &u8, &value as &u8, 8)
    ctx.out.constant(ty, bits)
}

find_address :: fn(ctx &Context, sym, node u32) Val {
    if sym == none() { ret Val.none }
    local := ctx.find_local(sym)
    if local != Val.none { ret local }
    if ctx.db.global_var(sym) != none() {
        ret ctx.out.address(ctx.module.register(sym, node))
    }
    Val.none
}

record_field :: fn(ctx &Context, address Val, ty, name, node u32) Val {
    field := ctx.field(ty, name, node)
    if ctx.module.native_layout(ty) {
        native := ctx.module.abi_type(ty, node)
        offset := if storage.native(ctx.db, ty) != none() {
            text := ctx.module.air.text(ctx.db.interner.get(name))
            ctx.out.field_offset(native, text, 0)
        } else {
            ctx.out.field_offset(native, field.index, 1)
        }
        ret ctx.out.offset(address, offset, 1)
    }
    ctx.offset(address, field.offset)
}

addressable :: fn(ctx &Context, node u32) bool {
    db := ctx.db
    match db.hir.kind(node) {
        ident {
            sym := db.get_hir_symbol(node)
            ret ctx.find_local(sym) != Val.none or db.global_var(sym) != none()
        }
        member {
            base := db.hir.lhs(node)
            ret db.global_var(db.get_hir_symbol(node)) != none() or
                db.types.kind(db.get_node_type(base)) == Kind.ptr or
                addressable(ctx, base)
        }
        index {
            base := db.hir.lhs(node)
            ret db.types.kind(db.get_node_type(base)) == Kind.ptr or addressable(ctx, base)
        }
        unary_deref { ret true }
        else { ret false }
    }
}

record_base :: fn(ctx &Context, node u32) Val {
    if ctx.db.types.kind(ctx.db.get_node_type(node)) == Kind.ptr { ret expr(ctx, node) }
    if addressable(ctx, node) { ret place(ctx, node) }
    expr(ctx, node)
}

place :: fn(ctx &Context, node u32) Val {
    db := ctx.db
    table := &db.hir
    left := table.lhs(node)
    match table.kind(node) {
        ident, member {
            found := find_address(ctx, db.get_hir_symbol(node), node)
            if found != Val.none { ret found }
            if table.kind(node) == k.member {
                ty := db.get_node_type(left)
                base := record_base(ctx, left)
                if not ctx.open() { ret Val.none }
                while db.types.kind(ty) == Kind.ptr {
                    ty = db.types.payload(ty)
                    if db.types.kind(ty) == Kind.ptr { base = ctx.out.load(Ty.ptr, base) }
                }
                ret record_field(ctx, base, ty, table.lhs(table.rhs(node)), node)
            }
            storage.error(db, node, "expression has no AIR address")
            ret Val.none
        }
        unary_deref {
            address := expr(ctx, left)
            if not ctx.open() { ret Val.none }
            if db.get_node_type(left) == db.str_type {
                field := record_field(ctx, address, db.str_type, ctx.module.sym_ptr_name, node)
                ret ctx.out.load(Ty.ptr, field)
            }
            ret address
        }
        index {
            base := record_base(ctx, left)
            if not ctx.open() { ret Val.none }
            source := db.get_node_type(left)
            if db.types.kind(source) == Kind.nominal or db.types.kind(source) == Kind.struct_ {
                base = ctx.out.load(
                    Ty.ptr
                    record_field(ctx, base, source, ctx.module.sym_ptr_name, node)
                )
            }
            ty := db.get_node_type(node)
            index := expr(ctx, table.rhs(node))
            if not ctx.open() { ret Val.none }
            ret ctx.element(base, index, ty, node)
        }
        else { storage.error(db, node, "expression has no AIR address"), ret Val.none }
    }
    Val.none
}

resolve_call :: fn(db &Nexus, node, callee u32) u32 {
    sym := db.resolve_sym(db.get_hir_symbol(callee))
    if sym == none() or db.global_var(sym) != none() or db.get_fn_node(sym) == none() { ret none() }
    concrete := db.get_const_type(node)
    if concrete != types.ty_id_none() {
        found := db.find_mono_sym(sym, concrete, db.mono_owner(callee, sym))
        if found != none() { ret found }
    }
    sym
}

receiver :: fn(ctx &Context, node, want u32) Val {
    db := ctx.db
    actual := db.get_node_type(node)
    have_depth: u32 = 0
    want_depth: u32 = 0
    db.types.unwrap_ptr_depth(actual, &have_depth)
    db.types.unwrap_ptr_depth(want, &want_depth)
    value := if have_depth < want_depth and addressable(ctx, node) {
        have_depth = have_depth + 1
        actual = db.types.alloc_ptr(actual)
        place(ctx, node)
    } else {
        expr(ctx, node)
    }
    if not ctx.open() { ret Val.none }
    while have_depth < want_depth {
        if not storage.aggregate(db, actual) {
            temp := ctx.slot(actual, node)
            ctx.write(actual, node, temp, value)
            value = temp
        }
        actual = db.types.alloc_ptr(actual)
        have_depth = have_depth + 1
    }
    while have_depth > want_depth {
        actual = db.types.payload(actual)
        value = ctx.read(actual, node, value, Val.none)
        have_depth = have_depth - 1
    }
    value
}

string_from_sym :: fn(
    ctx &Context
    sym Symbol
    len u64
    pointer_only bool
    node u32
    dest Val
) Val {
    pointer := ctx.out.address(sym)
    if pointer_only { ret pointer }
    ty := ctx.db.str_type
    result := if dest != Val.none { dest } else { ctx.slot(ty, node) }
    ctx.out.store(record_field(ctx, result, ty, ctx.module.sym_ptr_name, node), pointer)
    length := ctx.out.constant(Ty.u64_, len)
    ctx.out.store(record_field(ctx, result, ty, ctx.module.sym_len_name, node), length)
    result
}

string_value :: fn(ctx &Context, bytes Str, pointer_only bool, node u32, dest Val) Val {
    sym := ctx.module.intern_data(bytes)
    string_from_sym(ctx, sym, bytes.len, pointer_only, node, dest)
}

has_escape :: fn(raw Str) bool {
    i: u64 = 0
    while i < raw.len {
        if raw.ptr[i] == 92 { ret true }
        i = i + 1
    }
    false
}

literal_text :: fn(ctx &Context, node u32, c_string bool, dest Val) Val {
    tok := ctx.db.hir.lhs(node)
    cache_idx := (tok as u64) * 2 + (if c_string { 1 as u64 } else { 0 as u64 })
    ctx.module.ensure_literal_slot(cache_idx)
    cached := ctx.module.literals.get(cache_idx)
    if cached.symbol != Symbol.none {
        ret string_from_sym(ctx, cached.symbol, cached.len, c_string, node, dest)
    }
    quoted := ctx.db.interner.get(tok)
    source := if c_string and quoted.starts_with("c\"") { quoted.sub(1, quoted.len - 1) } else {
        quoted
    }
    raw := source.trim_quotes()
    backtick := source.len != 0 and source.ptr[0] == 96
    if not c_string and not has_escape(raw) {
        sym := ctx.module.intern_data(raw)
        ctx.module.literals.set(cache_idx, .{ symbol: sym, len: raw.len })
        ret string_from_sym(ctx, sym, raw.len, false, node, dest)
    }
    out := ctx.module.arena.alloc(raw.len + 1) as &u8
    out_len: u64 = 0
    index: u64 = 0
    while index < raw.len {
        out[out_len] = next_literal_byte(raw, backtick, &index)
        out_len = out_len + 1
    }
    text_len := out_len
    if c_string {
        out[out_len] = 0
        out_len = out_len + 1
    }
    sym := ctx.module.intern_data(Str.new(out, out_len))
    ctx.module.literals.set(cache_idx, .{ symbol: sym, len: text_len })
    string_from_sym(ctx, sym, text_len, c_string, node, dest)
}

next_literal_byte :: fn(raw Str, backtick bool, index &u64) u8 {
    i := *index
    ch := raw.ptr[i]
    i = i + 1
    if ch == 92 and i < raw.len {
        escape := raw.ptr[i]
        if escape == 96 and backtick {
            ch = 96
            i = i + 1
        } else if not backtick {
            i = i + 1
            if escape == 'n' { ch = 10 } else if escape == 'r' { ch = 13 } else if escape == 't' {
                ch = 9
            } else if escape >= '0' and escape <= '7' {
                ch = escape - '0'
                digits: u32 = 1
                while digits < 3 and i < raw.len and raw.ptr[i] >= '0' and raw.ptr[i] <= '7' {
                    ch = (ch << 3) | (raw.ptr[i] - '0')
                    i = i + 1
                    digits = digits + 1
                }
            } else if escape == 'x' and i + 1 < raw.len {
                ch = hex(raw.ptr[i]) * 16 + hex(raw.ptr[i + 1])
                i = i + 2
            } else { ch = escape }
        }
    }
    *index = i
    ch
}

hex :: fn(ch u8) u8 {
    if ch >= '0' and ch <= '9' { ret ch - '0' }
    (ch | 32) - 'a' + 10
}

record_init :: fn(ctx &Context, node, ty u32, dest Val) Val {
    db := ctx.db
    target := if dest != Val.none { dest } else { ctx.slot(ty, node) }
    if db.hir.kind(node) == k.array_init {
        elem := db.types.get_array_type(ty)
        elems := items(db, db.hir.lhs(node))
        arr_len := db.types.get_array_len(ty)
        if elems.len != arr_len as u64 { ctx.zero(ty, node, target) }
        offset: u32 = 0
        for item in elems {
            index := ctx.out.constant(Ty.u32_, offset as u64)
            into(ctx, item, elem, ctx.element(target, index, elem, item))
            if not ctx.open() { ret Val.none }
            offset = offset + 1
        }
        ret target
    }
    values := items(db, db.hir.rhs(node))
    fields := items(db, db.hir.lhs(node))
    decl_fields := db.types.get_struct_fields(ty)
    full := fields.len == values.len and fields.len * 2 == decl_fields.len and
        ctx.module.is_packed(ty, node)
    if full {
        pos: u64 = 0
        while pos < fields.len {
            if db.hir.lhs(fields.get(pos)) != decl_fields.get(pos * 2) {
                full = false
                break
            }
            pos = pos + 1
        }
    }
    if not full { ctx.zero(ty, node, target) }
    pos: u64 = 0
    while pos < fields.len and pos < values.len {
        name := db.hir.lhs(fields.get(pos))
        item := values.get(pos)
        field := ctx.field(ty, name, item)
        into(ctx, item, field.ty, record_field(ctx, target, ty, name, item))
        if not ctx.open() { ret Val.none }
        pos = pos + 1
    }
    target
}

unpack :: fn(ctx &Context, list, ty u32, value Val) {
    db := ctx.db
    index: u32 = 0
    for item in items(db, list) {
        kind := db.hir.kind(item)
        if kind == k.empty or db.get_hir_symbol(item) != none() {
            name := db.tuple_field_name(index)
            field := ctx.field(ty, name, item)
            field_addr := record_field(ctx, value, ty, name, item)
            if kind == k.empty or kind == k.tuple_type {
                part := ctx.read(field.ty, item, field_addr, Val.none)
                unpack(ctx, db.hir.lhs(item), field.ty, part)
            } else if storage.aggregate(db, field.ty) {
                slot := ctx.slot(field.ty, item)
                ctx.copy(field.ty, item, slot, field_addr)
                ctx.bind_local(db.get_hir_symbol(item), slot)
            } else {
                part := ctx.read(field.ty, item, field_addr, Val.none)
                ctx.local(item, field.ty, part)
            }
        }
        index = index + 1
    }
}

constant_value :: fn(ctx &Context, node, ty u32, bits u64, dest Val) Val {
    convert_constant(ctx, node, ty, ty, bits, dest)
}

convert_constant :: fn(ctx &Context, node, source, ty u32, bits u64, dest Val) Val {
    db := ctx.db
    if ty == db.str_type {
        if bits == 0 { ret string_value(ctx, Str.empty(), false, node, dest) }
        ptr := reflection.reflection_read(db, bits, ty, "ptr") as &u8
        len := reflection.reflection_read(db, bits, ty, "len")
        ret string_value(ctx, Str.new(ptr, len), false, node, dest)
    }
    if storage.aggregate(db, ty) {
        target := if dest != Val.none { dest } else { ctx.slot(ty, node) }
        ctx.zero(ty, node, target)
        if bits == 0 { ret target }
        kind := db.types.kind(ty)
        if kind == Kind.array {
            elem := db.types.get_array_type(ty)
            source_elem := db.types.get_array_type(source)
            stride := vm.vm_element_size(&db.types, source_elem)
            for index in Range.new(0, db.types.get_array_len(ty) as i32) {
                raw := legacy.read_vm_constant((bits + index as u64 * stride) as &u8, stride)
                address := ctx.element(target, ctx.out.constant(Ty.u32_, index as u64), elem, node)
                if storage.aggregate(db, elem) {
                    convert_constant(ctx, node, source_elem, elem, raw, address)
                } else {
                    value := convert_constant(ctx, node, source_elem, elem, raw, Val.none)
                    ctx.write(elem, node, address, value)
                }
            }
        } else if kind == Kind.union_ {
            tag := (bits as &u64)[0] as u32
            member := db.types.union_members(ty).get(tag as u64)
            ctx.out.store(target, ctx.out.constant(Ty.u32_, tag as u64))
            payload_addr := ctx.union_payload(target, ty, node)
            if storage.aggregate(db, member) {
                constant_value(ctx, node, member, (bits as &u64)[1], payload_addr)
            } else {
                value := constant_value(ctx, node, member, (bits as &u64)[1], Val.none)
                ctx.write(member, node, payload_addr, value)
            }
        } else {
            fields := db.types.get_struct_fields(ty)
            source_fields := db.types.get_struct_fields(source)
            position: u64 = 0
            while position < fields.len / 2 {
                item := fields.get(position * 2 + 1)
                old_ty := source_fields.get(position * 2 + 1)
                address := record_field(ctx, target, ty, fields.get(position * 2), node)
                if storage.aggregate(db, item) {
                    convert_constant(ctx, node, old_ty, item, (bits as &u64)[position], address)
                } else {
                    value := convert_constant(
                        ctx
                        node
                        old_ty
                        item
                        (bits as &u64)[position]
                        Val.none
                    )
                    ctx.write(item, node, address, value)
                }
                position = position + 1
            }
        }
        ret target
    }
    if bits != 0 and (db.types.kind(ty) == Kind.ptr or db.types.kind(ty) == Kind.func) {
        db.type_error(node, "compile-time pointers cannot escape into runtime code")
    }
    if db.types.kind(ty) == Kind.float and
        storage.scalar(db, source, node) != storage.scalar(db, ty, node) {
        if db.types.kind(source) == Kind.float or db.types.kind(source) == Kind.untyped_float {
            float := if db.types.payload(source) == 32 { (*(&bits as &f32)) as f64 } else {
                *(&bits as &f64)
            }
            ret number(ctx, storage.scalar(db, ty, node), float)
        }
    }
    ctx.out.constant(storage.scalar(db, ty, node), bits)
}

name_value :: fn(ctx &Context, node, ty u32, dest Val) Val {
    db := ctx.db
    table := &db.hir
    if table.kind(node) == k.member { module_effect(ctx, table.lhs(node)) }
    if not ctx.open() { ret Val.none }
    sym := db.resolve_sym(db.get_hir_symbol(node))
    direct := ctx.find_val(sym)
    if direct != Val.none { ret ctx.out.cast(storage.scalar(db, ty, node), direct) }
    address := find_address(ctx, sym, node)
    if address != Val.none { ret ctx.read(ty, node, address, dest) }
    if db.types.kind(ty) == Kind.func and db.get_fn_node(sym) != none() {
        chosen := resolve_call(db, node, node)
        ret ctx.out.address(ctx.module.function_address(chosen, node))
    }
    if db.has_const_val(node) and not storage.aggregate(db, ty) {
        ret constant_value(ctx, node, ty, db.get_const_val(node), Val.none)
    }
    if table.kind(node) == k.member {
        lhs := table.lhs(node)
        lhs_type := db.get_node_type(lhs)
        if lhs_type == types.ty_id_type() and db.types.kind(ty) == Kind.enum_ {
            value := db.types.enum_variant_val(ty, table.lhs(table.rhs(node)))
            ret ctx.out.constant(storage.scalar(db, ty, node), value as u64)
        }
        if lhs_type != types.ty_id_type() and db.module_receiver(lhs) == none() {
            address = place(ctx, node)
            if not ctx.open() { ret Val.none }
            ret ctx.read(ty, node, address, dest)
        }
    }
    if db.is_sym_const(sym) {
        declaration := db.get_sym_hir(sym)
        if declaration != none() and db.has_const_val(declaration) {
            ret constant_value(ctx, node, ty, db.get_const_val(declaration), dest)
        }
        init := db.binding_value(sym)
        if init != none() {
            mark_addressed(ctx, init)
            value := expr_into(ctx, init, dest)
            if not ctx.open() { ret Val.none }
            if storage.aggregate(db, ty) { ret ctx.fit(value, ty, node, dest) }
            ret ctx.out.cast(storage.scalar(db, ty, node), value)
        }
    }
    storage.error(db, node, "unresolved runtime name")
    Val.none
}

builtin :: fn(ctx &Context, node, ty u32, dest Val) Val {
    db := ctx.db
    table := &db.hir
    name := db.interner.get(table.lhs(node))
    if name.eq("import") {
        ret if dest != Val.none { dest } else { ctx.slot(ty, node) }
    }
    if name.eq("trap") { ctx.out.trap(), ret Val.none }
    if name.eq("sizeof") {
        ret ctx.out.cast(storage.scalar(db, ty, node), ctx.size(db.get_const_type(node), node))
    }
    if name.eq("type_name") or name.eq("source_location") {
        ret expr_into(ctx, table.extra(node), dest)
    }
    if name.eq("type_info") { ret reflection_address(ctx, node) }
    args := items(db, table.rhs(node))
    if name.eq("c_value") {
        abi.require_headers(db, node)
        header := ctx.module.air.text(db.interner.get(table.lhs(args.get(0))).trim_quotes())
        key := ctx.module.air.text(db.interner.get(table.lhs(args.get(1))).trim_quotes())
        ret ctx.out.header_value(storage.scalar(db, ty, node), header, key)
    }
    if name.eq("memcpy") {
        dest_ptr := expr(ctx, args.get(0))
        source := expr(ctx, args.get(1))
        count := expr(ctx, args.get(2))
        if ctx.open() { ctx.out.copy_bytes(dest_ptr, source, count) }
        ret Val.none
    }
    if name.eq("is") or name.eq("tag") {
        target := db.get_const_type(node)
        arg := args.get(0)
        source := db.get_node_type(arg)
        union := db.types.kind(source) == Kind.union_
        value := expr(ctx, arg)
        if not ctx.open() { ret Val.none }
        tag := if union { ctx.out.load(Ty.u32_, value) } else { ctx.out.constant(Ty.u32_, 0) }
        if name.eq("tag") { ret ctx.out.cast(storage.scalar(db, ty, node), tag) }
        if not union or not db.types.union_contains(source, target) {
            ret ctx.out.constant(Ty.i1, (source == target) as u64)
        }
        index := ctx.out.constant(Ty.u32_, db.types.union_member_index(source, target) as u64)
        ret ctx.out.binary(Op.eq, tag, index)
    }
    storage.error(db, node, "builtin has no AIR lowering")
    Val.none
}

expr :: fn(ctx &Context, node u32) Val {
    expr_into(ctx, node, Val.none)
}

expr_into :: fn(ctx &Context, node u32, dest Val) Val {
    if node == none() or not ctx.open() { ret Val.none }
    db := ctx.db
    ty := db.get_node_type(node)
    if ty == types.ty_id_type() and not db.has_const_val(node) { ret Val.none }
    if db.has_union_coerce(node) {
        target := db.get_union_coerce_ty(node)
        index := db.get_union_coerce_idx(node)
        member := db.types.union_members(target).get(index as u64)
        slot := if dest != Val.none { dest } else { ctx.slot(target, node) }
        ctx.zero(target, node, slot)
        ctx.out.store(slot, ctx.out.constant(Ty.u32_, index as u64))
        payload := ctx.union_payload(slot, target, node)
        inner_dest := if storage.aggregate(db, member) { payload } else { Val.none }
        value := raw_expr(ctx, node, member, inner_dest)
        if not ctx.open() { ret Val.none }
        if not storage.aggregate(db, member) or value != payload {
            ctx.write(member, node, payload, value)
        }
        ret slot
    }
    raw_expr(ctx, node, ty, dest)
}

pack_union :: fn(ctx &Context, node, target, index, member u32, value Val, dest Val) Val {
    result := if dest != Val.none { dest } else { ctx.slot(target, node) }
    ctx.zero(target, node, result)
    ctx.out.store(result, ctx.out.constant(Ty.u32_, index as u64))
    ctx.write(member, node, ctx.union_payload(result, target, node), value)
    result
}

returning :: fn(ctx &Context, node u32) {
    if not ctx.open() { ret }
    db := ctx.db
    table := &db.hir
    if node != none() and not db.has_union_coerce(node) {
        kind := table.kind(node)
        if kind == k.block {
            xs := items(db, table.lhs(node))
            if xs.len != 0 {
                last := xs.len - 1
                i: u64 = 0
                while i < last {
                    expr(ctx, xs.get(i))
                    if not ctx.open() { ret }
                    i = i + 1
                }
                returning(ctx, xs.get(last))
                ret
            }
        } else if kind == k.k_if and table.extra(node) != none() {
            test := expr(ctx, table.lhs(node))
            if not ctx.open() { ret }
            yes := ctx.out.block()
            no := ctx.out.block()
            ctx.out.branch(test, yes, no)
            ctx.out.begin(yes)
            returning(ctx, table.rhs(node))
            ctx.out.begin(no)
            returning(ctx, table.extra(node))
            ret
        }
    }
    if ctx.return_slot != Val.none and quiet(ctx, node, none()) {
        into(ctx, node, ctx.return_ty, ctx.return_slot)
        if ctx.open() { ctx.out.ret_void() }
        ret
    }
    ctx.finish(expr(ctx, node), node)
}

raw_expr :: fn(ctx &Context, node, ty u32, dest Val) Val {
    db := ctx.db
    table := &db.hir
    kind := table.kind(node)
    left := table.lhs(node)
    right := table.rhs(node)
    extra := table.extra(node)
    match kind {
        empty, binding, struct_, enum_, nominal_tuple, tuple_type { ret Val.none }
        lit_bool_true, lit_bool_false {
            ret ctx.out.constant(Ty.i1, (kind == k.lit_bool_true) as u64)
        }
        lit_int, lit_char {
            value := if kind == k.lit_int { left as u64 } else { db.get_const_val(node) }
            target := storage.scalar(db, ty, node)
            if target == Ty.f32_ or target == Ty.f64_ { ret number(ctx, target, value as f64) }
            ret ctx.out.constant(target, value)
        }
        lit_float {
            ret number(ctx, storage.scalar(db, ty, node), parse_float(db.interner.get(left)))
        }
        lit_str, lit_cstr {
            ret literal_text(
                ctx
                node
                kind == k.lit_cstr or db.types.kind(ty) == Kind.ptr
                dest
            )
        }
        ident, member { ret name_value(ctx, node, ty, dest) }
        function {
            if db.types.func_has_type_param(ty) { ret Val.none }
            ret ctx.out.address(ctx.module.function_address(db.get_hir_symbol(node), node))
        }
        call { ret call(ctx, node, left, Val.none, dest) }
        block {
            xs := items(db, left)
            if xs.len == 0 { ret Val.none }
            last := xs.len - 1
            i: u64 = 0
            while i < last {
                expr(ctx, xs.get(i))
                if not ctx.open() { ret Val.none }
                i = i + 1
            }
            ret expr_into(ctx, xs.get(last), dest)
        }
        var {
            decl_ty := db.get_node_type(left)
            if decl_ty == types.ty_id_type() or db.types.func_has_type_param(decl_ty) {
                ret Val.none
            }
            local_sym := db.get_hir_symbol(left)
            if storage.aggregate(db, decl_ty) and quiet(ctx, extra, local_sym) {
                slot := ctx.slot(decl_ty, left)
                ctx.bind_local(local_sym, slot)
                into(ctx, extra, decl_ty, slot)
                ret Val.none
            }
            value := expr(ctx, extra)
            if ctx.open() { ctx.local(left, decl_ty, value) }
            ret Val.none
        }
        destructure {
            value := expr(ctx, extra)
            if ctx.open() { unpack(ctx, table.lhs(left), db.get_node_type(extra), value) }
            ret Val.none
        }
        binary_assign {
            address := place(ctx, left)
            value := expr(ctx, right)
            if not ctx.open() { ret Val.none }
            ctx.write(db.get_node_type(left), node, address, value)
            ret ctx.fit(value, ty, node, dest)
        }
        binary_add, binary_sub, binary_mul, binary_div, binary_mod, binary_eq_eq, binary_neq, binary_lt, binary_lt_eq, binary_gt, binary_gt_eq, binary_bit_and, binary_bit_or, binary_bit_xor, binary_shl, binary_shr {
            ret binary_expr(ctx, node, left, right)
        }
        binary_and, binary_or { ret logical(ctx, kind, left, right) }
        unary_neg, unary_not, unary_bit_not {
            value := expr(ctx, left)
            if not ctx.open() { ret Val.none }
            op := if kind == k.unary_neg { Op.neg } else { Op.invert }
            ret ctx.out.unary(op, value)
        }
        unary_addr_of { ret place(ctx, left) }
        unary_deref, index {
            address := place(ctx, node)
            if not ctx.open() { ret Val.none }
            ret ctx.read(ty, node, address, dest)
        }
        cast {
            if table.kind(left) == k.lit_int and table.lhs(left) > 2147483647 {
                target := storage.scalar(db, ty, node)
                if target == Ty.f32_ or target == Ty.f64_ {
                    ret number(ctx, target, table.lhs(left) as f64)
                }
                ret ctx.out.constant(target, table.lhs(left) as u64)
            }
            source := db.get_node_type(left)
            if db.types.kind(source) == Kind.union_ and source != ty {
                value := expr(ctx, left)
                if not ctx.open() { ret Val.none }
                tag := ctx.out.load(Ty.u32_, value)
                chosen := db.types.union_member_index(source, ty)
                pass := ctx.out.block()
                fail := ctx.out.block()
                ctx.out.branch(
                    ctx.out.binary(Op.eq, tag, ctx.out.constant(Ty.u32_, chosen as u64))
                    pass
                    fail
                )
                ctx.out.begin(fail)
                ctx.out.trap()
                ctx.out.begin(pass)
                ret ctx.read(ty, node, ctx.union_payload(value, source, node), dest)
            }
            value := expr_into(ctx, left, if storage.aggregate(db, ty) { dest } else { Val.none })
            if not ctx.open() { ret Val.none }
            if storage.aggregate(db, ty) { ret ctx.fit(value, ty, node, dest) }
            ret ctx.out.cast(storage.scalar(db, ty, node), value)
        }
        k_if { ret conditional(ctx, node, left, right, extra, dest) }
        k_while { while_loop(ctx, left, right), ret Val.none }
        k_for { for_loop(ctx, node), ret Val.none }
        k_match { ret match_expr(ctx, node, ty, dest) }
        k_ret { returning(ctx, left), ret Val.none }
        k_break { ctx.out.jump(ctx.break_to), ret Val.none }
        k_cont { ctx.out.jump(ctx.continue_to), ret Val.none }
        struct_init, array_init { ret record_init(ctx, node, ty, dest) }
        k_cmpt {
            if db.has_const_val(node) {
                bits := db.get_const_val(node)
                if db.types.kind(ty) == Kind.union_ and db.types.kind(right) != Kind.union_ and
                    db.has_union_coerce(left) {
                    index := db.get_union_coerce_idx(left)
                    member := db.types.union_members(ty).get(index as u64)
                    slot := if dest != Val.none { dest } else { ctx.slot(ty, node) }
                    ctx.zero(ty, node, slot)
                    ctx.out.store(slot, ctx.out.constant(Ty.u32_, index as u64))
                    payload := ctx.union_payload(slot, ty, node)
                    if storage.aggregate(db, member) {
                        convert_constant(ctx, node, right, member, bits, payload)
                    } else {
                        item := convert_constant(ctx, node, right, member, bits, Val.none)
                        ctx.write(member, node, payload, item)
                    }
                    ret slot
                }
                ret convert_constant(ctx, node, right, ty, bits, dest)
            }
            storage.error(db, node, "comptime expression has no evaluated value")
            ret Val.none
        }
        splice {
            if right == 1 { ret call(ctx, extra, table.lhs(extra), Val.none, dest) }
            ret expr_into(ctx, extra, dest)
        }
        builtin_call { ret builtin(ctx, node, ty, dest) }
        else { storage.error(db, node, hir.hir_kind_name(kind)), ret Val.none }
    }
    Val.none
}

reflection_address :: fn(ctx &Context, node u32) Val {
    db := ctx.db
    ty := db.types.payload(db.get_node_type(node))
    source := reflection.reflection_value(db, node)
    ctx.out.address(ctx.module.reflect(source, ty, 0, node))
}

lower_metadata :: fn(ctx &Context, data Metadata) {
    timing := profile.enter(Phase.backend_metadata)
    lower_metadata_impl(ctx, data)
    profile.leave(timing)
}

lower_metadata_impl :: fn(ctx &Context, data Metadata) {
    db := ctx.db
    table := &db.types
    dest := ctx.out.address(data.target)
    bits := data.source as &u64
    if data.count != 0 {
        width := @sizeof(&u8) as u32
        record := table.payload(data.ty)
        pointers := data.source as &&u8
        for index in Range.new(0, data.count as i32) {
            item := ctx.module.reflect(pointers[index] as u64, record, 0, data.node)
            address := ctx.offset(dest, index as u32 * width)
            ctx.out.store(address, ctx.out.address(item))
        }
        ret
    }
    fields := table.get_struct_fields(data.ty)
    position: u64 = 0
    for index in Range.new(0, (fields.len / 2) as i32) {
        name := fields.get(index as u64 * 2)
        ty := fields.get(index as u64 * 2 + 1)
        shape := ctx.module.shape(ty, data.node)
        offset := storage.align_up(position as u32, shape.align)
        address := ctx.offset(dest, offset)
        position = (offset + shape.size) as u64
        raw := bits[index]
        if raw == 0 { cont }
        value := if table.kind(ty) == Kind.ptr {
            count_name := if name == ctx.module.sym_fields_name {
                "field_count"
            } else if name == ctx.module.sym_members_name {
                "member_count"
            } else if name == ctx.module.sym_params_name {
                "param_count"
            } else {
                Str.empty()
            }
            count := if count_name.len == 0 { 0 as u32 } else {
                reflection.reflection_read(db, data.source, data.ty, count_name) as u32
            }
            ctx.out.address(ctx.module.reflect(raw, table.payload(ty), count, data.node))
        } else {
            constant_value(ctx, data.node, ty, raw, Val.none)
        }
        ctx.write(ty, data.node, address, value)
    }
}

lower_body :: fn(module &Module, pending Pending) {
    timing := profile.enter(Phase.backend_functions)
    lower_body_impl(module, pending)
    profile.leave(timing)
}

mark_ident_slot :: fn(ctx &Context, node u32) {
    sym := ctx.db.get_hir_symbol(node)
    if sym == none() { ret }
    ctx.mark_need_slot(sym)
    resolved := ctx.db.resolve_sym(sym)
    if resolved != sym and resolved != none() { ctx.mark_need_slot(resolved) }
}

mark_place_sym :: fn(ctx &Context, node u32) {
    db := ctx.db
    table := &db.hir
    cur := node
    while cur != none() {
        kind := table.kind(cur)
        if kind == k.ident {
            mark_ident_slot(ctx, cur)
            ret
        }
        if kind != k.member and kind != k.index { ret }
        base := table.lhs(cur)
        if base == none() or db.types.kind(db.get_node_type(base)) == Kind.ptr { ret }
        cur = base
    }
}

mark_addressed :: fn(ctx &Context, node u32) {
    if node == none() { ret }
    db := ctx.db
    table := &db.hir
    kind := table.kind(node)
    left := table.lhs(node)
    right := table.rhs(node)
    extra := table.extra(node)
    match kind {
        unary_addr_of {
            mark_place_sym(ctx, left)
            mark_addressed(ctx, left)
        }
        binary_assign, binary_assign_add, binary_assign_sub, binary_assign_mul, binary_assign_div, binary_assign_mod, binary_assign_bit_and, binary_assign_bit_or, binary_assign_bit_xor, binary_assign_shl, binary_assign_shr {
            mark_place_sym(ctx, left)
            mark_addressed(ctx, left)
            mark_addressed(ctx, right)
        }
        call {
            if left != none() and table.kind(left) == k.member {
                base := table.lhs(left)
                if base != none() and table.kind(base) == k.ident and
                    db.module_receiver(base) == none() {
                    bty := db.get_node_type(base)
                    if bty != types.ty_id_type() and db.types.kind(bty) != Kind.ptr and
                        not storage.aggregate(db, bty) {
                        mark_ident_slot(ctx, base)
                    }
                }
            }
            mark_addressed(ctx, left)
            for arg in items(db, right) { mark_addressed(ctx, arg) }
        }
        block {
            for item in items(db, left) { mark_addressed(ctx, item) }
        }
        struct_init {
            for item in items(db, right) { mark_addressed(ctx, item) }
        }
        array_init {
            for item in items(db, left) { mark_addressed(ctx, item) }
        }
        builtin_call {
            for item in items(db, right) { mark_addressed(ctx, item) }
        }
        k_if {
            mark_addressed(ctx, left)
            mark_addressed(ctx, right)
            mark_addressed(ctx, extra)
        }
        k_while {
            mark_addressed(ctx, left)
            mark_addressed(ctx, right)
        }
        k_for {
            for iter in items(db, right) {
                if table.kind(iter) == k.for_iter {
                    mark_addressed(ctx, table.lhs(iter))
                    mark_addressed(ctx, table.rhs(iter))
                } else {
                    mark_addressed(ctx, iter)
                }
            }
            mark_addressed(ctx, extra)
        }
        k_match {
            mark_addressed(ctx, left)
            for arm in items(db, right) { mark_addressed(ctx, table.rhs(arm)) }
        }
        var, destructure, splice {
            mark_addressed(ctx, extra)
        }
        binary_add, binary_sub, binary_mul, binary_div, binary_mod, binary_eq_eq, binary_neq, binary_lt, binary_lt_eq, binary_gt, binary_gt_eq, binary_and, binary_or, binary_bit_and, binary_bit_or, binary_bit_xor, binary_shl, binary_shr, index {
            mark_addressed(ctx, left)
            mark_addressed(ctx, right)
        }
        member, unary_neg, unary_not, unary_bit_not, unary_deref, cast, k_ret {
            mark_addressed(ctx, left)
        }
        else {}
    }
}

lower_body_impl :: fn(module &Module, pending Pending) {
    db := module.db
    sym := pending.source
    node := db.get_fn_node(sym)
    if db.is_mono_sym(sym) { db.restore_mono_func(sym) }
    sig := func_type(db, sym, node)
    ctx := Context.new(
        module
        db.types.func_return(sig)
        &module.locals
        &module.local_kinds
        &module.local_dirty
    )
    decl := module.air.get(pending.target)
    signature := if decl.count == 0 { Slice(Ty).empty() } else {
        Slice(Ty).new(module.air.types.ptr_at(decl.params as u64), decl.count as u64)
    }
    entry := ctx.out.block_with_params(signature)
    ctx.out.begin(entry)
    index: u32 = 0
    if storage.aggregate(db, ctx.return_ty) {
        ctx.return_slot = ctx.out.parameter(entry, 0)
        index = 1
    }
    body := db.hir.extra(node)
    mark_addressed(&ctx, body)
    args := items(db, db.hir.lhs(node))
    params := db.types.func_params(sig)
    pos: u64 = 0
    while pos < args.len and pos < params.len {
        arg := args.get(pos)
        ty := params.get(pos)
        if runtime_arg(db, node, pos, ty) {
            name := db.hir.lhs(arg)
            if name != none() { ctx.local(name, ty, ctx.out.parameter(entry, index)) }
            index = index + 1
        }
        pos = pos + 1
    }
    returning(&ctx, body)
    module.air.define(pending.target, ctx.out)
}

lower_globals :: fn(module &Module, lowered &u64) {
    timing := profile.enter(Phase.backend_globals)
    lower_globals_impl(module, lowered)
    profile.leave(timing)
}

lower_globals_impl :: fn(module &Module, lowered &u64) {
    if module.globals.len == 0 and module.metadata.len == 0 { ret }
    module.air.initializer = module.air.declare("$init", Slice(Ty).empty(), Ty.void_, false)
    sym_cap := module.db.sym_count() as u64 + 16
    module.init_locals.reserve(sym_cap)
    module.init_locals.len = sym_cap
    mem.mem_set(module.init_locals.ptr as &u8, 0, sym_cap * @sizeof(Val))
    module.init_kinds.reserve(sym_cap)
    module.init_kinds.len = sym_cap
    mem.mem_set(module.init_kinds.ptr as &u8, 0, sym_cap)
    ctx := Context.new(
        module
        types.ty_id_unit()
        &module.init_locals
        &module.init_kinds
        &module.init_dirty
    )
    ctx.out.begin(ctx.out.block())
    index: u64 = 0
    prepared: u64 = 0
    while index < module.globals.len or prepared < module.metadata.len or
        *lowered < module.pending.len {
        if *lowered < module.pending.len {
            lower_body(module, module.pending.get(*lowered))
            *lowered = *lowered + 1
            cont
        }
        if prepared < module.metadata.len {
            lower_metadata(&ctx, module.metadata.get(prepared))
            prepared = prepared + 1
            cont
        }
        init := module.globals.get(index)
        name := module.db.hir.lhs(init.source)
        node := module.db.hir.extra(init.source)
        mark_addressed(&ctx, node)
        address := ctx.out.address(init.target)
        value := expr(&ctx, node)
        if not ctx.open() { storage.error(module.db, node, "global initializer cannot terminate") }
        ctx.write(module.db.get_node_type(name), node, address, value)
        index = index + 1
    }
    ctx.out.ret_void()
    module.air.define(module.air.initializer, ctx.out)
}

lower :: fn(db &Nexus, arena &Arena, file, entry, selected u32) Program {
    timing := profile.enter(Phase.backend_lower)
    result := lower_impl(db, arena, file, entry, selected)
    profile.leave(timing)
    result
}

lower_impl :: fn(db &Nexus, arena &Arena, file, entry, selected u32) Program {
    module := Module.new(db, arena)
    if selected != none() {
        module.air.entry = module.register(selected, db.get_fn_node(selected))
    } else {
        if entry != none() { module.air.entry = module.register(entry, db.get_fn_node(entry)) }
        index: u32 = 0
        while index < db.sym_count() {
            sym := index
            index = index + 1
            if db.sym_tok_start(sym) == none() or db.resolve_sym(sym) != sym { cont }
            global := db.global_var(sym)
            if global != none() {
                module.register(sym, global)
                cont
            }
            node := db.get_fn_node(sym)
            if node == none() { cont }
            if db.native_output {
                if not db.is_extern_fn(node) or db.hir.extra(node) == none() { cont }
            } else if db.sym_file(sym) != file and not db.is_extern_fn(node) { cont }
            ty := db.get_node_type(node)
            if db.types.kind(ty) != Kind.func or db.types.func_has_type_param(ty) or
                db.types.func_return(ty) == types.ty_id_type() { cont }
            if db.hir.extra(node) != none() or db.is_extern_fn(node) { module.register(sym, node) }
        }
    }
    index: u64 = 0
    while index < module.pending.len {
        lower_body(&module, module.pending.get(index))
        index = index + 1
    }
    lower_globals(&module, &index)
    module.destroy_scratch()
    opt.run(&module.air, if db.target_arch == Arch.wasm32 { 4 } else { 8 })
    module.air
}

for_loop :: fn(ctx &Context, node u32) {
    db := ctx.db
    table := &db.hir
    iterators := items(db, table.rhs(node))
    variables := items(db, table.lhs(node))
    if iterators.len > 4 or variables.len > 4 {
        for_loop_heap(ctx, node, iterators, variables)
        ret
    }
    s_states: [4]Val
    s_addrs: [4]Val
    s_vals: [4]Val
    state_count: u64 = 0
    for iter in iterators {
        source := if table.kind(iter) == k.for_iter { table.lhs(iter) } else { iter }
        s_states[state_count] = expr(ctx, source)
        state_count = state_count + 1
    }
    addr_count: u64 = 0
    for name in variables {
        address := ctx.slot(db.get_node_type(name), name)
        ctx.bind_local(db.get_hir_symbol(name), address)
        s_addrs[addr_count] = address
        addr_count = addr_count + 1
    }
    head := ctx.out.block()
    end := ctx.out.block()
    ctx.out.jump(head)
    ctx.out.begin(head)
    present := ctx.module.sym_present_name
    value_name := ctx.module.sym_value_name
    ptr_name := ctx.module.sym_ptr_name
    index_name := ctx.module.sym_index_name
    len_name := ctx.module.sym_len_name
    val_count: u64 = 0
    position: u64 = 0
    for iter in iterators {
        state := s_states[position]
        ty := db.get_node_type(iter)
        run := ctx.out.block()
        if table.kind(iter) == k.for_iter {
            next := table.rhs(iter)
            result := call(ctx, next, table.lhs(next), state, Val.none)
            ty = db.get_node_type(next)
            condition := ctx.out.load(Ty.i1, record_field(ctx, result, ty, present, next))
            ctx.out.branch(condition, run, end)
            ctx.out.begin(run)
            item := ctx.field(ty, value_name, next)
            s_vals[val_count] = ctx.read(item.ty, next, ctx.offset(result, item.offset), Val.none)
            val_count = val_count + 1
        } else {
            index := ctx.field(ty, index_name, iter)
            index_ty := storage.scalar(db, index.ty, iter)
            index_slot := ctx.offset(state, index.offset)
            offset := ctx.out.load(index_ty, index_slot)
            length := ctx.out.load(index_ty, record_field(ctx, state, ty, len_name, iter))
            ctx.out.branch(ctx.out.binary(Op.lt, offset, length), run, end)
            ctx.out.begin(run)
            ptr_type := ctx.field(ty, ptr_name, iter).ty
            pointer := ctx.out.load(Ty.ptr, record_field(ctx, state, ty, ptr_name, iter))
            element := db.types.payload(ptr_type)
            address := ctx.element(pointer, offset, element, iter)
            item_ty := db.get_node_type(variables.get(position))
            s_vals[val_count] = if legacy.iterator_is_ref(db, ty) { address } else {
                ctx.read(item_ty, iter, address, Val.none)
            }
            val_count = val_count + 1
            ctx.out.store(
                index_slot
                ctx.out.binary(Op.iadd, offset, ctx.out.constant(index_ty, 1))
            )
        }
        position = position + 1
    }
    position = 0
    for name in variables {
        ctx.write(db.get_node_type(name), name, s_addrs[position], s_vals[position])
        position = position + 1
    }
    saved := .(ctx.break_to, ctx.continue_to)
    ctx.break_to = end
    ctx.continue_to = head
    expr(ctx, table.extra(node))
    jump_to(ctx, head, Ty.void_, Val.none)
    ctx.break_to = saved.0
    ctx.continue_to = saved.1
    ctx.out.begin(end)
}

for_loop_heap :: fn(ctx &Context, node u32, iterators, variables Slice(u32)) {
    db := ctx.db
    table := &db.hir
    h_states := Vec(Val).with_cap(iterators.len)
    h_addrs := Vec(Val).with_cap(variables.len)
    h_vals := Vec(Val).with_cap(iterators.len)
    for iter in iterators {
        source := if table.kind(iter) == k.for_iter { table.lhs(iter) } else { iter }
        h_states.push(expr(ctx, source))
    }
    for name in variables {
        address := ctx.slot(db.get_node_type(name), name)
        ctx.bind_local(db.get_hir_symbol(name), address)
        h_addrs.push(address)
    }
    head := ctx.out.block()
    end := ctx.out.block()
    ctx.out.jump(head)
    ctx.out.begin(head)
    present := ctx.module.sym_present_name
    value_name := ctx.module.sym_value_name
    ptr_name := ctx.module.sym_ptr_name
    index_name := ctx.module.sym_index_name
    len_name := ctx.module.sym_len_name
    position: u64 = 0
    for iter in iterators {
        state := h_states.get(position)
        ty := db.get_node_type(iter)
        run := ctx.out.block()
        if table.kind(iter) == k.for_iter {
            next := table.rhs(iter)
            result := call(ctx, next, table.lhs(next), state, Val.none)
            ty = db.get_node_type(next)
            condition := ctx.out.load(Ty.i1, record_field(ctx, result, ty, present, next))
            ctx.out.branch(condition, run, end)
            ctx.out.begin(run)
            item := ctx.field(ty, value_name, next)
            h_vals.push(ctx.read(item.ty, next, ctx.offset(result, item.offset), Val.none))
        } else {
            index := ctx.field(ty, index_name, iter)
            index_ty := storage.scalar(db, index.ty, iter)
            index_slot := ctx.offset(state, index.offset)
            offset := ctx.out.load(index_ty, index_slot)
            length := ctx.out.load(index_ty, record_field(ctx, state, ty, len_name, iter))
            ctx.out.branch(ctx.out.binary(Op.lt, offset, length), run, end)
            ctx.out.begin(run)
            ptr_type := ctx.field(ty, ptr_name, iter).ty
            pointer := ctx.out.load(Ty.ptr, record_field(ctx, state, ty, ptr_name, iter))
            element := db.types.payload(ptr_type)
            address := ctx.element(pointer, offset, element, iter)
            item_ty := db.get_node_type(variables.get(position))
            value := if legacy.iterator_is_ref(db, ty) { address } else {
                ctx.read(item_ty, iter, address, Val.none)
            }
            h_vals.push(value)
            ctx.out.store(
                index_slot
                ctx.out.binary(Op.iadd, offset, ctx.out.constant(index_ty, 1))
            )
        }
        position = position + 1
    }
    position = 0
    for name in variables {
        ctx.write(db.get_node_type(name), name, h_addrs.get(position), h_vals.get(position))
        position = position + 1
    }
    h_states.destroy()
    h_addrs.destroy()
    h_vals.destroy()
    saved := .(ctx.break_to, ctx.continue_to)
    ctx.break_to = end
    ctx.continue_to = head
    expr(ctx, table.extra(node))
    jump_to(ctx, head, Ty.void_, Val.none)
    ctx.break_to = saved.0
    ctx.continue_to = saved.1
    ctx.out.begin(end)
}

match_expr :: fn(ctx &Context, node, result_ty u32, dest Val) Val {
    db := ctx.db
    table := &db.hir
    source := table.lhs(node)
    value := expr(ctx, source)
    if not ctx.open() { ret Val.none }
    ty := db.get_node_type(source)
    union := db.types.kind(ty) == Kind.union_
    tag := if union { ctx.out.load(Ty.u32_, value) } else { value }
    tag_ty := ctx.out.value_type(tag)
    is_agg := result_ty != types.ty_id_none() and storage.aggregate(db, result_ty)
    agg_dest := if is_agg {
        if dest != Val.none { dest } else { ctx.slot(result_ty, node) }
    } else {
        Val.none
    }
    result := if is_agg { Ty.void_ } else { storage.scalar(db, result_ty, node) }
    end := join(ctx, result)
    incoming := false
    for arm in items(db, table.rhs(node)) {
        patterns := items(db, table.lhs(arm))
        if patterns.len != 0 {
            pass := ctx.out.block()
            for pattern in patterns {
                index := if union {
                    db.types.union_member_index(ty, db.get_const_type(pattern))
                } else {
                    name := if table.kind(pattern) == k.member {
                        table.lhs(table.rhs(pattern))
                    } else { table.lhs(pattern) }
                    db.types.enum_variant_val(ty, name)
                }
                next := ctx.out.block()
                test := ctx.out.binary(Op.eq, tag, ctx.out.constant(tag_ty, index as u64))
                ctx.out.branch(test, pass, next)
                ctx.out.begin(next)
            }
            resume := ctx.out.current
            ctx.out.suspend()
            ctx.out.begin(pass)
            binder := table.extra(arm)
            if binder != none() and table.extra(node) != none() and
                table.kind(table.extra(node)) == k.match_binding {
                item_ty := db.get_node_type(binder)
                if union and storage.aggregate(db, item_ty) {
                    slot := ctx.slot(item_ty, binder)
                    ctx.copy(item_ty, binder, slot, ctx.union_payload(value, ty, node))
                    ctx.bind_local(db.get_hir_symbol(binder), slot)
                } else {
                    item := if union {
                        ctx.read(item_ty, binder, ctx.union_payload(value, ty, node), Val.none)
                    } else {
                        value
                    }
                    ctx.local(binder, item_ty, item)
                }
            }
            item := expr_into(ctx, table.rhs(arm), agg_dest)
            if ctx.open() {
                incoming = true
                if is_agg and item != agg_dest and item != Val.none {
                    ctx.copy(result_ty, node, agg_dest, item)
                }
            }
            jump_to(ctx, end, result, item)
            ctx.out.begin(resume)
        } else {
            item := expr_into(ctx, table.rhs(arm), agg_dest)
            if ctx.open() {
                incoming = true
                if is_agg and item != agg_dest and item != Val.none {
                    ctx.copy(result_ty, node, agg_dest, item)
                }
            }
            jump_to(ctx, end, result, item)
            break
        }
    }
    if ctx.open() { ctx.out.trap() }
    output := open_join(ctx, end, result)
    if not incoming {
        ctx.out.trap()
        ret Val.none
    }
    if is_agg { ret agg_dest }
    output
}

call :: fn(ctx &Context, node, callee u32, supplied, dest Val) Val {
    db := ctx.db
    if db.hir.kind(callee) == k.member {
        base := db.hir.lhs(callee)
        array := db.types.unwrap_ptr(db.get_node_type(base))
        if db.types.kind(array) == Kind.array {
            ret array_iterator(ctx, node, callee, base, array, dest)
        }
    }
    sym := resolve_call(db, node, callee)
    func := db.get_fn_node(sym)
    sig := if sym == none() { db.get_node_type(callee) } else { func_type(db, sym, func) }
    if db.types.kind(sig) != Kind.func { storage.error(db, node, "unresolved call signature") }
    target := if sym == none() { Symbol.none } else { ctx.module.register(sym, node) }
    address := if target == Symbol.none { expr(ctx, callee) } else { Val.none }
    if target == Symbol.none and not ctx.open() { ret Val.none }
    result := db.types.func_return(sig)
    params := db.types.func_params(sig)
    raw_args := items(db, db.hir.rhs(node))
    if raw_args.len > 14 {
        ret call_heap(
            ctx
            node
            callee
            supplied
            dest
            sym
            func
            sig
            target
            address
            result
            params
            raw_args
        )
    }
    stack_args: [16]Val
    arg_count: u64 = 0
    result_slot := if storage.aggregate(db, result) {
        if dest != Val.none { dest } else { ctx.slot(result, node) }
    } else {
        Val.none
    }
    if result_slot != Val.none {
        stack_args[0] = result_slot
        arg_count = 1
    }
    if target != Symbol.none and db.hir.kind(callee) == k.member {
        base := db.hir.lhs(callee)
        if db.module_receiver(base) != none() {
            module_effect(ctx, base)
        } else if func_has_self(db, func) {
            arg := if supplied != Val.none { supplied } else { receiver(ctx, base, params.get(0)) }
            stack_args[arg_count] = arg
            arg_count = arg_count + 1
        }
        if not ctx.open() { ret Val.none }
    }
    index: u32 = 0
    for arg in raw_args {
        ty := db.get_node_type(arg)
        if not db.is_const_call_arg(node, index) and ty != types.ty_id_type() {
            value := expr(ctx, arg)
            if not ctx.open() { ret Val.none }
            if target != Symbol.none {
                decl := ctx.module.air.get(target)
                if arg_count < decl.count as u64 {
                    want := ctx.module.air.types.get(decl.params as u64 + arg_count)
                    value = ctx.out.cast(want, value)
                }
            }
            stack_args[arg_count] = value
            arg_count = arg_count + 1
        }
        index = index + 1
    }
    args_slice := if arg_count == 0 {
        Slice(Val).empty()
    } else {
        Slice(Val).new(&stack_args[0], arg_count)
    }
    ty := if result_slot != Val.none { Ty.void_ } else { storage.scalar(db, result, node) }
    value := if target == Symbol.none {
        ctx.out.call_abi(address, ty, args_slice, ctx.module.abi_type(sig, node))
    } else {
        ctx.out.call(target, ty, args_slice)
    }
    if result == types.ty_id_never() {
        ctx.out.trap()
        ret Val.none
    }
    if result_slot != Val.none { ret result_slot }
    value
}

call_heap :: fn(
    ctx &Context
    node, callee u32
    supplied, dest Val
    sym, func, sig u32
    target Symbol
    address Val
    result u32
    params Slice(u32)
    raw_args Slice(u32)
) Val {
    db := ctx.db
    heap_args := Vec(Val).with_cap(raw_args.len + 2)
    result_slot := if storage.aggregate(db, result) {
        if dest != Val.none { dest } else { ctx.slot(result, node) }
    } else {
        Val.none
    }
    if result_slot != Val.none { heap_args.push(result_slot) }
    if target != Symbol.none and db.hir.kind(callee) == k.member {
        base := db.hir.lhs(callee)
        if db.module_receiver(base) != none() {
            module_effect(ctx, base)
        } else if func_has_self(db, func) {
            arg := if supplied != Val.none { supplied } else { receiver(ctx, base, params.get(0)) }
            heap_args.push(arg)
        }
        if not ctx.open() {
            heap_args.destroy()
            ret Val.none
        }
    }
    index: u32 = 0
    for arg in raw_args {
        ty := db.get_node_type(arg)
        if not db.is_const_call_arg(node, index) and ty != types.ty_id_type() {
            value := expr(ctx, arg)
            if not ctx.open() {
                heap_args.destroy()
                ret Val.none
            }
            if target != Symbol.none {
                decl := ctx.module.air.get(target)
                if heap_args.len < decl.count as u64 {
                    want := ctx.module.air.types.get(decl.params as u64 + heap_args.len)
                    value = ctx.out.cast(want, value)
                }
            }
            heap_args.push(value)
        }
        index = index + 1
    }
    ty := if result_slot != Val.none { Ty.void_ } else { storage.scalar(db, result, node) }
    value := if target == Symbol.none {
        ctx.out.call_abi(address, ty, heap_args.as_slice(), ctx.module.abi_type(sig, node))
    } else {
        ctx.out.call(target, ty, heap_args.as_slice())
    }
    heap_args.destroy()
    if result == types.ty_id_never() {
        ctx.out.trap()
        ret Val.none
    }
    if result_slot != Val.none { ret result_slot }
    value
}

module_effect :: fn(ctx &Context, node u32) {
    if ctx.db.module_receiver(node) != none() and not ctx.db.is_const(node) {
        expr(ctx, node)
    }
}

array_iterator :: fn(ctx &Context, node, callee, base, array u32, dest Val) Val {
    db := ctx.db
    pointer := record_base(ctx, base)
    if not ctx.open() { ret Val.none }
    actual := db.get_node_type(base)
    while db.types.kind(actual) == Kind.ptr {
        actual = db.types.payload(actual)
        if db.types.kind(actual) == Kind.ptr { pointer = ctx.out.load(Ty.ptr, pointer) }
    }
    signature := db.get_node_type(callee)
    ty := db.types.func_return(signature)
    iter := if dest != Val.none { dest } else { ctx.slot(ty, node) }
    ctx.out.store(record_field(ctx, iter, ty, ctx.module.sym_ptr_name, node), pointer)
    length := ctx.out.constant(Ty.u64_, db.types.get_array_len(array) as u64)
    ctx.out.store(record_field(ctx, iter, ty, ctx.module.sym_len_name, node), length)
    zero := ctx.out.constant(Ty.u64_, 0)
    ctx.out.store(record_field(ctx, iter, ty, ctx.module.sym_index_name, node), zero)
    iter
}
