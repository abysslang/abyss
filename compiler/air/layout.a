keel :: @import("pods/keel")
types :: @import("compiler/types")
Nexus :: @import("compiler/nexus/nexus").Nexus
fall :: @import("std/sys").fall
Ty :: keel.Ty
Kind :: types.TyKind
Arch :: @import("core/target").Arch
topo :: @import("compiler/topo_sort")

Shape :: struct {
    size, align u32
}

Field :: struct {
    offset, ty, index u32
}

error :: fn(db &Nexus, node u32, message Str) {
    printf("\n[air error] {}\n       --> ", .(message))
    db.print_loc(node)
    print("")
    #fall
}

aggregate :: fn(db &Nexus, ty u32) bool {
    kind := db.types.kind(ty)
    kind == Kind.struct_ or kind == Kind.nominal or kind == Kind.array or kind == Kind.union_
}

native :: fn(db &Nexus, ty u32) u32 {
    if db.types.kind(ty) != Kind.nominal { ret hir_none() }
    db.native_type_node(ty)
}

scalar :: fn(db &Nexus, ty, node u32) Ty {
    table := &db.types
    match table.kind(ty) {
        unit, never { ret Ty.void_ }
        bool { ret Ty.i1 }
        untyped_int { ret Ty.i32_ }
        untyped_float { ret Ty.f64_ }
        ptr, func, array, struct_, nominal, union_ { ret Ty.ptr }
        enum_ { ret scalar(db, table.enum_backing(ty), node) }
        float { ret if table.payload(ty) == 32 { Ty.f32_ } else { Ty.f64_ } }
        int, uint {
            signed := table.kind(ty) == Kind.int
            bits := table.payload(ty)
            if bits == 8 { ret if signed { Ty.i8_ } else { Ty.u8_ } }
            if bits == 16 { ret if signed { Ty.i16_ } else { Ty.u16_ } }
            if bits == 32 { ret if signed { Ty.i32_ } else { Ty.u32_ } }
            if bits == 64 { ret if signed { Ty.i64_ } else { Ty.u64_ } }
            if bits == 128 { ret if signed { Ty.i128_ } else { Ty.u128_ } }
            error(db, node, "integer width has no fixed AIR representation")
            ret Ty.void_
        }
        else {
            error(db, node, "type has no fixed AIR representation")
            ret Ty.void_
        }
    }
}

align_up :: fn(size, align u32) u32 {
    (size + align - 1) & ~(align - 1)
}

shape :: fn(db &Nexus, ty, node u32) Shape {
    shape_at(db, ty, node, 0)
}

shape_at :: fn(db &Nexus, ty, node, depth u32) Shape {
    table := &db.types
    if depth == 64 {
        queue := Vec(u32).new()
        queue.push(ty)
        sorted := topo.topo_sort(db, &queue)
        sorted.destroy()
        queue.destroy()
    }
    match table.kind(ty) {
        nominal {
            if db.native_type_node(ty) != hir_none() {
                error(db, node, "AIR cannot determine the layout of a C header type")
            }
            ret shape_at(db, table.nominal_base(ty), node, depth + 1)
        }
        array {
            item := shape_at(db, table.get_array_type(ty), node, depth + 1)
            size := item.size as u64 * table.get_array_len(ty) as u64
            if size > 4294967295 as u64 { error(db, node, "AIR object exceeds 4 GiB") }
            ret .{ size: size as u32, align: item.align }
        }
        struct_ {
            fields := table.get_struct_fields(ty)
            offset: u32 = 0
            alignment: u32 = 1
            i: u64 = 1
            while i < fields.len {
                item := shape_at(db, fields.get(i), node, depth + 1)
                offset = align_up(offset, item.align) + item.size
                if alignment < item.align { alignment = item.align }
                i = i + 2
            }
            ret .{ size: align_up(offset, alignment), align: alignment }
        }
        union_ {
            alignment: u32 = 4
            size: u32 = 0
            for member in table.union_members(ty) {
                item := shape_at(db, member, node, depth + 1)
                if size < item.size { size = item.size }
                if alignment < item.align { alignment = item.align }
            }
            ret .{ size: align_up(alignment + size, alignment), align: alignment }
        }
        else {
            size := match scalar(db, ty, node) {
                void_ { 0 as u32 }
                i1, i8_, u8_ { 1 as u32 }
                i16_, u16_ { 2 as u32 }
                i32_, u32_, f32_ { 4 as u32 }
                i64_, u64_, f64_ { 8 as u32 }
                i128_, u128_ { 16 as u32 }
                ptr { if db.target_arch == Arch.wasm32 { 4 as u32 } else { 8 as u32 } }
            }
            ret .{ size: size, align: if size == 0 { 1 as u32 } else { size } }
        }
    }
}

union_align :: fn(db &Nexus, ty, node u32) u32 {
    align: u32 = 4
    for member in db.types.union_members(ty) {
        item := shape(db, member, node)
        if align < item.align { align = item.align }
    }
    align
}

field :: fn(db &Nexus, ty, name, node u32, dynamic bool) Field {
    fields := db.types.get_struct_fields(ty)
    offset: u32 = 0
    i: u64 = 0
    while i < fields.len {
        item_ty := fields.get(i + 1)
        if not dynamic {
            item := shape(db, item_ty, node)
            offset = align_up(offset, item.align)
            if fields.get(i) != name { offset = offset + item.size }
        }
        if fields.get(i) == name { ret .{ offset: offset, ty: item_ty, index: (i / 2) as u32 } }
        i = i + 2
    }
    error(db, node, "field has no runtime offset")
    .{ offset: 0, ty: types.ty_id_none(), index: 0 }
}

hir_none :: @import("compiler/hir").hir_none
