Os :: @import("core/target").Os
Arena :: @import("std/allocator").Arena
text :: @import("std/fmt")
String :: @import("std/string").String
fall :: @import("std/sys").fall

hir :: @import("./hir")
native_thread :: @import("./native_thread")
HirExprKind :: hir.HirExprKind
decode_char_lit :: @import("./lexer").decode_char_lit
Nexus :: @import("./nexus/nexus").Nexus
reflection :: @import("./typer/reflection")
type_defs :: @import("./types")
TypeStorage :: type_defs.TypeStorage

is_process_symbol :: fn(name Str) bool {
    name.eq("abyss_process_arg_count") or name.eq("abyss_process_arg") or
        name.eq("abyss_process_args") or
        name.eq("abyss_process_set_args")
}

integer_type :: fn(width u32, signed bool) Str {
    if width == 8 { ret if signed { "int8_t" } else { "uint8_t" } }
    if width == 16 { ret if signed { "int16_t" } else { "uint16_t" } }
    if width == 32 { ret if signed { "int32_t" } else { "uint32_t" } }
    if width == 64 { ret if signed { "int64_t" } else { "uint64_t" } }
    if width == 128 { ret if signed { "__int128" } else { "unsigned __int128" } }
    print("\n[codegen error] unsupported integer width")
    #fall
    ""
}

LoopCondition :: struct {
    id        u32
    breaks    bool
    continues bool
}

LoopScope :: struct {
    outer    LoopCondition
    id       u32
    breaks   bool
    iterator bool
}

CCodeBuilder :: struct {
    new :: fn() Self {
        .{}
    }

    new_list :: fn(self &Self, arena &Arena) String {
        String.new(arena)
    }

    append_list_item :: fn(self &Self, list &String, value Str, first bool) {
        if not first { list.push_str(", ") }
        list.push_str(value)
    }

    finish_list :: fn(self &Self, list &String) Str {
        list.as_str()
    }
}

CCodeGen :: struct {
    arena                &Arena
    struct_forward_decls String
    struct_decls         String
    struct_defs          String
    func_decls           String
    global_decls         String
    global_defs          String
    reflection_count     u32
    static_init          bool
    code                 String
    emitted_types        HashSet(u32)
    main_sym             u32
    has_main             bool
    main_returns_status  bool
    target_os            Os
    uses_threads         bool
    indent               u32
    loop_condition       LoopCondition
    temp_count           u32
    new :: fn(arena &Arena) Self {
        .{
            arena: arena
            struct_forward_decls: String.new(arena)
            struct_decls: String.new(arena)
            struct_defs: String.new(arena)
            func_decls: String.new(arena)
            global_decls: String.new(arena)
            global_defs: String.new(arena)
            reflection_count: 0
            static_init: false
            code: String.new(arena)
            emitted_types: HashSet(u32).new()
            main_sym: 0
            has_main: false
            main_returns_status: false
            target_os: Os.linux
            uses_threads: false
            indent: 0
            loop_condition: .{ id: hir.hir_none(), breaks: false, continues: false }
            temp_count: 0
        }
    }

    destroy :: fn(self &Self) {
        self.emitted_types.destroy()
    }

    empty_value :: fn(self &Self) Str {
        Str.empty()
    }

    is_vm :: fn(self &Self) bool {
        false
    }

    intrinsic_trap :: fn(self &Self) Str { "__builtin_trap()" }

    intrinsic_memcpy :: fn(self &Self, arena &Arena, args Str) Str {
        text.Fmt.new(arena).wrap("(void)__builtin_memcpy(", args, ")").as_str()
    }

    has_value :: fn(self &Self, value Str) bool {
        value.len > 0
    }

    extern_name :: fn(self &Self, name Str, ty u32) Str {
        name
    }

    expr_typed_float :: fn(self &Self, raw Str, narrow bool) Str {
        if narrow { text.Fmt.new(self.arena).wrap("((float)(", raw, "))").as_str() } else { raw }
    }

    expr_folded_float :: fn(self &Self, arena &Arena, value f64, narrow bool) Str {
        bits := *(&value as &u64)
        exponent := ((bits >> 52) & 2047) as i32
        fraction := bits & (((1 as u64) << 52) - 1)
        fmt := text.Fmt.new(arena)
        fmt.str("(")
        if (bits >> 63) != 0 {
            fmt.str("-")
        }
        if exponent == 2047 {
            fmt.str(if fraction == 0 { "(1.0/0.0)" } else { "(0.0/0.0)" })
        } else {
            fmt.str(if exponent == 0 { "0x0." } else { "0x1." })
            for index in Range.new(0, 13) {
                digit := ((fraction >> (((12 - index) * 4) as u64)) & 15) as u64
                fmt.char("0123456789abcdef".ptr[digit])
            }
            fmt.str("p").int32(if exponent == 0 { -1022 } else { exponent - 1023 })
        }
        fmt.str(")")
        self.expr_typed_float(fmt.as_str(), narrow)
    }

    empty_parameters :: fn(self &Self) Str {
        "void"
    }

    parameter_name :: fn(self &Self, arena &Arena, index u32) Str {
        text.Fmt.new(arena).sym("_a", index).as_str()
    }

    parameter :: fn(self &Self, arena &Arena, ty, name Str) Str {
        text.Fmt.new(arena).str(ty).space().str(name).as_str()
    }

    indent_line :: fn(self &Self) {
        for i in Range.new(0, self.indent as i32) { self.code.push_str("    ") }
    }

    abyss_main :: fn(self &Self, sym_id u32) {
        self.main_sym = sym_id
        self.has_main = true
    }

    reset_locals :: fn(self &Self) {}

    declare_function :: fn(self &Self, fn_name, ret_type, params Str) {
        text.fmt_into(&self.func_decls, "{} {}({});\n", .{ ret_type, fn_name, params })
    }

    declare_foreign :: fn(self &Self, fn_name, ret_type, params, module, name Str) {
        if module.len == 0 and native_thread.is_symbol(name) {
            self.uses_threads = true
            ret
        }
        if self.target_os == Os.wasi and
            (name.eq("__builtin_wasm_memory_size") or name.eq("__builtin_wasm_memory_grow")) { ret }
        if is_process_symbol(name) {
            self.func_decls.push_str("static ")
        } else if module.len > 0 {
            text.fmt_into(
                &self.func_decls
                "__attribute__((import_module(\"{}\"), import_name(\"{}\"))) "
                .{ module, name }
            )
        } else if self.target_os == Os.darwin {
            alias := if name.eq("opendir") { "__DARWIN_ALIAS_I" } else if name.eq("readdir") {
                "__DARWIN_INODE64"
            } else if name.eq("closedir") { "__DARWIN_ALIAS" } else { "" }
            if alias.len > 0 {
                text.fmt_into(
                    &self.func_decls
                    "{} {}({}) {}({});\n"
                    .{ ret_type, fn_name, params, alias, name }
                )
                ret
            }
        }
        self.declare_function(fn_name, ret_type, params)
    }

    start_function :: fn(self &Self, fn_name, ret_type, params Str, exported bool) {
        if not exported or is_process_symbol(fn_name) {
            self.func_decls.push_str("static ")
            self.code.push_str("static ")
        }
        self.declare_function(fn_name, ret_type, params)
        self.temp_count = 0
        text.fmt_into(&self.code, "{} {}({}) {{\n", .{ ret_type, fn_name, params })
        self.indent = self.indent + 1
    }

    end_function :: fn(self &Self) {
        if self.indent > 0 {
            self.indent = self.indent - 1
        }
        self.code.push_str("}\n\n")
    }

    begin_inline_scope :: fn(self &Self) {
        self.indent_line()
        self.code.push_str("{\n")
        self.indent = self.indent + 1
    }

    end_inline_scope :: fn(self &Self) {
        self.indent = self.indent - 1
        self.indent_line()
        self.code.push_str("}\n")
    }

    global_ref :: fn(self &Self, arena &Arena, sym u32, ty u32) Str {
        self.sym_name(arena, sym)
    }

    declare_global :: fn(self &Self, sym, ty u32, name, type_name Str) {
        text.fmt_into(&self.global_decls, "static {} {};\n", .{ type_name, name })
    }

    begin_globals :: fn(self &Self) {
        self.static_init = true
    }

    initialize_global :: fn(self &Self, name, ty, value Str) {
        text.fmt_into(&self.global_defs, "static {} {} = {};\n", .{ ty, name, value })
    }

    end_globals :: fn(self &Self) {
        self.static_init = false
    }

    create_variable :: fn(self &Self, name, ty, init_val Str, has_init bool) {
        self.indent_line()
        value := if has_init { init_val } else { "{0}" }
        text.fmt_into(&self.code, "{} {} = {};\n", .{ ty, name, value })
    }

    new_temp :: fn(self &Self, arena &Arena, ty Str) Str {
        self.temp_count = self.temp_count + 1
        name := text.Fmt.new(arena).sym("_t", self.temp_count).as_str()
        self.create_variable(name, ty, "", false)
        name
    }

    expr :: fn(self &Self, e Str) {
        if e.len == 0 { ret }
        self.indent_line()
        text.fmt_into(&self.code, "{};\n", .{ e })
    }

    gen_return :: fn(self &Self, val Str, has_val bool) {
        self.indent_line()
        if has_val and val.len > 0 {
            text.fmt_into(&self.code, "return {};\n", .{ val })
        } else {
            self.code.push_str("return;\n")
        }
    }

    start_if :: fn(self &Self, cond Str) {
        self.indent_line()
        text.fmt_into(&self.code, "if ({}) {{\n", .{ cond })
        self.indent = self.indent + 1
    }

    else_ :: fn(self &Self) {
        if self.indent > 0 {
            self.indent = self.indent - 1
        }
        self.indent_line()
        self.code.push_str("} else {\n")
        self.indent = self.indent + 1
    }

    start_while :: fn(self &Self, cond Str) {
        self.indent_line()
        text.fmt_into(&self.code, "while ({}) {{\n", .{ cond })
        self.indent = self.indent + 1
    }

    end_block :: fn(self &Self) {
        if self.indent > 0 {
            self.indent = self.indent - 1
        }
        self.indent_line()
        self.code.push_str("}\n")
    }

    loop_label :: fn(self &Self, arena &Arena, id u32, suffix Str) Str {
        text.Fmt.new(arena).sym("_loop_", id).str(suffix).as_str()
    }

    loop_begin_label :: fn(self &Self, arena &Arena, id u32) Str {
        self.loop_label(arena, id, "_begin")
    }

    loop_end_label :: fn(self &Self, arena &Arena, id u32) Str {
        self.loop_label(arena, id, "_end")
    }

    iterator_name :: fn(self &Self, arena &Arena, id, index u32) Str {
        text.Fmt.new(arena).sym("_for_", id).char('_').uint32(index).as_str()
    }

    iterator_next_name :: fn(self &Self, arena &Arena, id, index u32) Str {
        text.Fmt.new(arena).sym("_for_next_", id).char('_').uint32(index).as_str()
    }

    emit_label :: fn(self &Self, label Str) {
        self.indent_line()
        text.fmt_into(&self.code, "{}:;\n", .{ label })
    }

    emit_goto :: fn(self &Self, label Str) {
        self.indent_line()
        text.fmt_into(&self.code, "goto {};\n", .{ label })
    }

    emit_break :: fn(self &Self, arena &Arena) {
        if self.loop_condition.id == hir.hir_none() {
            self.expr("break")
        } else {
            self.loop_condition.breaks = true
            self.emit_goto(self.loop_label(arena, self.loop_condition.id, "_end"))
        }
    }

    emit_cont :: fn(self &Self, arena &Arena) {
        if self.loop_condition.id == hir.hir_none() {
            self.expr("continue")
        } else {
            self.loop_condition.continues = true
            self.emit_goto(self.loop_label(arena, self.loop_condition.id, "_begin"))
        }
    }

    break_statement :: fn(self &Self) {
        self.expr("break")
    }

    begin_loop :: fn(self &Self, id u32) LoopScope {
        scope: LoopScope = .{ outer: self.loop_condition, id: id, breaks: false, iterator: false }
        self.set_loop(id, false, false)
        scope
    }

    start_loop :: fn(self &Self, arena &Arena, scope &LoopScope) {
        scope.breaks = self.loop_condition.breaks
        continues := self.loop_condition.continues
        self.set_loop(hir.hir_none(), false, false)
        if continues {
            self.emit_label(self.loop_begin_label(arena, scope.id))
        }
        self.start_while("1")
    }

    start_iterator_loop :: fn(self &Self, arena &Arena, scope &LoopScope) {
        scope.iterator = true
        self.start_while("1")
        self.emit_label(self.loop_begin_label(arena, scope.id))
    }

    end_loop :: fn(self &Self, arena &Arena, scope &LoopScope) {
        breaks := scope.breaks
        if scope.iterator {
            breaks = self.loop_condition.breaks
        }
        self.end_block()
        if breaks {
            self.emit_label(self.loop_end_label(arena, scope.id))
        }
        self.loop_condition = scope.outer
    }

    set_loop :: fn(self &Self, id u32, breaks bool, continues bool) {
        self.loop_condition = .{ id: id, breaks: breaks, continues: continues }
    }

    start_struct :: fn(self &Self, name Str) {
        text.fmt_into(&self.struct_forward_decls, "typedef struct {} {};\n", .{ name, name })
        text.fmt_into(&self.struct_defs, "struct {} {{\n", .{ name })
    }

    define_struct :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32) {
        fields := types.get_struct_fields(ty_id)
        if fields.len == 0 {
            self.struct_defs.push_str("    uint8_t _dummy;\n")
        }
        for field in fields.chunks(2) {
            ty := self.type_str(types, arena, field.get(1))
            text.fmt_into(&self.struct_defs, "    {} _f{};\n", .{ ty, field.get(0) })
        }
    }

    define_func_type :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32, name Str) {
        ret_type := self.type_str(types, arena, types.func_return(ty_id))
        dst := &self.struct_decls
        text.fmt_into(dst, "typedef {} (*{})(", .{ ret_type, name })
        params := types.func_params(ty_id)
        if params.len == 0 {
            dst.push_str("void")
        } else {
            first := true
            for ty in params {
                if not first { dst.push_str(", ") }
                dst.push_str(self.type_str(types, arena, ty))
                first = false
            }
        }
        dst.push_str(");\n")
    }

    define_union :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32) {
        dst := &self.struct_defs
        dst.push_str("    uint32_t tag;\n    union {\n")
        index: u32 = 0
        for member in types.union_members(ty_id) {
            ty := self.type_str(types, arena, member)
            text.fmt_into(dst, "        {} _v{};\n", .{ ty, index })
            index = index + 1
        }
        dst.push_str("    } val;\n")
    }

    define_type :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32) {
        kind := types.kind(ty_id)
        if kind == type_defs.TyKind.nominal and
            types.nominal_base(ty_id) == type_defs.ty_id_none() { ret }
        if not self.emitted_types.insert(ty_id) { ret }

        name := TypeStorage.name(arena, ty_id)
        match kind {
            func {
                self.define_func_type(types, arena, ty_id, name)
                ret
            }
            enum_ {
                backing := self.type_str(types, arena, types.enum_backing(ty_id))
                text.fmt_into(&self.struct_decls, "typedef {} {};\n", .{ backing, name })
                ret
            }
            struct_, nominal, union_, array {}
            else { ret }
        }
        self.start_struct(name)
        match kind {
            struct_, nominal { self.define_struct(types, arena, ty_id) }
            union_ { self.define_union(types, arena, ty_id) }
            array {
                ty := self.type_str(types, arena, types.get_array_type(ty_id))
                text.fmt_into(
                    &self.struct_defs
                    "    {} _v[{}];\n"
                    .{ ty, types.get_array_len(ty_id) }
                )
            }
            else {}
        }
        self.struct_defs.push_str("};\n\n")
    }

    c_header :: fn(self &Self) Str {
        if self.target_os == Os.wasi or self.target_os == Os.freestanding {
            ret `#include <stdint.h>
#include <stdbool.h>
#include <stddef.h>
`
        }
        `#ifndef _GNU_SOURCE
#define _GNU_SOURCE
#endif
#include <stdint.h>
#include <stdbool.h>
#include <stddef.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#ifdef __TINYC__
#define __int128 long long
typedef uint16_t _Float16;
#endif
`
    }

    finish :: fn(self &Self) Str {
        threads := if not self.uses_threads { "" } else if self.target_os == Os.windows {
            native_thread.windows
        } else {
            native_thread.posix
        }
        parts := .[
            self.c_header()
            threads
            self.struct_forward_decls.as_str()
            self.struct_decls.as_str()
            self.struct_defs.as_str()
            self.func_decls.as_str()
            self.global_decls.as_str()
            self.global_defs.as_str()
            self.code.as_str()
        ]
        length: u64 = 0
        for part in parts { length = length + part.len }
        out := String.new(self.arena)
        out.reserve(length)
        for part in parts { out.push_str(part) }

        if self.has_main {
            if self.target_os == Os.wasi {
                out.push_str("int32_t abyss_main(void) { ")
            } else {
                out.push_str(
                    "int main(int argc, char **argv) { abyss_process_set_args(argc, (uint8_t **)argv); "
                )
            }
            prefix := if self.main_returns_status { "return " } else { "" }
            suffix := if self.main_returns_status { "" } else { "return 0; " }
            text.fmt_into(&out, "{}sym_{}(); {}}}\n", .{ prefix, self.main_sym, suffix })
        }
        out.as_str()
    }

    type_str :: fn(self &Self, types &TypeStorage, arena &Arena, ty_id u32) Str {
        if ty_id == type_defs.ty_id_none() {
            print("\n[codegen error] missing type")
            #fall
        }
        kind := types.kind(ty_id)
        width := types.payload(ty_id)
        match kind {
            unit { "void" }
            bool { "bool" }
            type_ { "uint32_t" }
            untyped_int { "int32_t" }
            untyped_float { "double" }
            int, uint { integer_type(width, kind == type_defs.TyKind.int) }
            float {
                if width == 32 { ret "float" }
                if width == 64 { ret "double" }
                print("\n[codegen error] unsupported float width")
                #fall
                ""
            }
            ptr {
                inner := self.type_str(types, arena, width)
                text.Fmt.new(arena).str(inner).char('*').as_str()
            }
            struct_, nominal, func, enum_, union_, array { TypeStorage.name(arena, ty_id) }
            infer, unknown, error {
                print("\n[codegen error] unresolved type")
                #fall
                ""
            }
            else {
                print("\n[codegen error] unsupported type")
                #fall
                ""
            }
        }
    }

    sym_name :: fn(self &Self, arena &Arena, sym_id u32) Str {
        text.Fmt.new(arena).sym("sym_", sym_id).as_str()
    }

    expr_int :: fn(self &Self, arena &Arena, val u32) Str {
        text.Fmt.new(arena).uint32(val).as_str()
    }

    expr_u64 :: fn(self &Self, arena &Arena, val u64) Str {
        text.Fmt.new(arena).uint64(val).str("ULL").as_str()
    }

    expr_typed_cast :: fn(self &Self, arena &Arena, ty Str, inner Str, source u32) Str {
        self.expr_cast(arena, ty, inner)
    }

    expr_typed_binary_kind :: fn(
        self &Self
        arena &Arena
        kind HirExprKind
        lhs Str
        rhs Str
        ty u32
    ) Str {
        self.expr_binary_kind(arena, kind, lhs, rhs)
    }

    expr_float_from_int :: fn(self &Self, arena &Arena, val u32, ty_id u32) Str {
        self.expr_int(arena, val)
    }

    expr_one :: fn(self &Self, arena &Arena) Str {
        "1"
    }

    format_raw_str :: fn(arena &Arena, raw Str) Str {
        if (raw.len < 2) or (raw.ptr[0] != 96) {
            ret raw
        }
        fmt := text.Fmt.new(arena)
        fmt.str("\"")
        i: u64 = 1
        end := raw.len - 1
        while i < end {
            c := raw.ptr[i]
            if c == 10 {
                fmt.str("\\n")
            } else if c == 13 {
                fmt.str("\\r")
            } else if c == 9 {
                fmt.str("\\t")
            } else if c == 34 {
                fmt.str("\\\"")
            } else if c == 92 {
                if (i + 1 < end) and (raw.ptr[i + 1] == 96) {
                    fmt.char(96 as u8)
                    i = i + 1
                } else {
                    fmt.str("\\\\")
                }
            } else {
                fmt.char(c)
            }
            i = i + 1
        }
        fmt.str("\"")
        fmt.as_str()
    }

    expr_str_lit :: fn(
        self &Self
        arena &Arena
        struct_name Str
        ptr_id u32
        len_id u32
        raw Str
    ) Str {
        c_raw := raw
        if (raw.len >= 2) and (raw.ptr[0] == 96) {
            c_raw = Self.format_raw_str(arena, raw)
        }
        fmt := text.Fmt.new(arena)
        if struct_name.len == 0 {
            fmt.wrap("((uint8_t*)", c_raw, ")")
            ret fmt.as_str()
        }
        fmt.str("._f").uint32(ptr_id).str(" = ((uint8_t*)").str(c_raw).str("), ._f").uint32(
            len_id
        ).str(" = (sizeof(").str(c_raw).str(") - 1)")
        self.expr_struct_init(arena, struct_name, fmt.as_str())
    }

    expr_char_lit :: fn(self &Self, arena &Arena, raw Str) Str {
        self.expr_int(arena, decode_char_lit(raw))
    }

    expr_cstr_lit :: fn(self &Self, arena &Arena, raw Str) Str {
        c_raw := raw
        if (raw.len >= 2) and (raw.ptr[0] == 'c') {
            c_raw = raw.sub(1, raw.len - 1)
        } else if (raw.len >= 2) and (raw.ptr[0] == 96) {
            c_raw = Self.format_raw_str(arena, raw)
        }
        text.Fmt.new(arena).wrap("((uint8_t*)", c_raw, ")").as_str()
    }

    expr_bool :: fn(self &Self, val bool) Str {
        if val { "true" } else { "false" }
    }

    expr_assign :: fn(self &Self, arena &Arena, lhs, rhs Str) Str {
        text.Fmt.new(arena).str(lhs).str(" = ").str(rhs).as_str()
    }

    expr_binary :: fn(self &Self, arena &Arena, op, lhs, rhs Str) Str {
        text.Fmt.new(arena).binary(op, lhs, rhs).as_str()
    }

    expr_zero :: fn(self &Self, arena &Arena, ty Str) Str {
        text.Fmt.new(arena).wrap("((", ty, "){0})").as_str()
    }

    expr_unary :: fn(self &Self, arena &Arena, op, inner Str) Str {
        text.Fmt.new(arena).char('(').str(op).wrap("(", inner, "))").as_str()
    }

    expr_neg :: fn(self &Self, arena &Arena, inner Str, ty u32) Str {
        self.expr_unary(arena, "-", inner)
    }

    expr_not :: fn(self &Self, arena &Arena, inner Str) Str {
        self.expr_unary(arena, "!", inner)
    }

    expr_bit_not :: fn(self &Self, arena &Arena, inner Str) Str {
        self.expr_unary(arena, "~", inner)
    }

    expr_typed_address :: fn(self &Self, arena &Arena, inner Str, ty u32) Str {
        self.expr_address(arena, inner)
    }

    expr_address :: fn(self &Self, arena &Arena, inner Str) Str {
        self.expr_unary(arena, "&", inner)
    }

    expr_typed_deref :: fn(self &Self, arena &Arena, inner Str, ty u32) Str {
        self.expr_deref(arena, inner)
    }

    expr_deref :: fn(self &Self, arena &Arena, inner Str) Str {
        self.expr_unary(arena, "*", inner)
    }

    expr_str_deref :: fn(self &Self, arena &Arena, inner Str, ptr_id u32) Str {
        text.Fmt.new(arena).str("(*(").str(inner).sym("._f", ptr_id).str("))").as_str()
    }

    expr_cast :: fn(self &Self, arena &Arena, ty_str, inner Str) Str {
        text.Fmt.new(arena).wrap("((", ty_str, ")").str(inner).char(')').as_str()
    }

    expr_call :: fn(self &Self, arena &Arena, callee, args Str, ty u32) Str {
        text.Fmt.new(arena).str(callee).paren(args).as_str()
    }

    expr_typed_member :: fn(
        self &Self
        arena &Arena
        lhs Str
        depth u32
        field_id u32
        struct_ty u32
    ) Str {
        self.expr_member(arena, lhs, depth, field_id)
    }

    expr_member :: fn(self &Self, arena &Arena, lhs Str, depth u32, field_id u32) Str {
        fmt := text.Fmt.new(arena)
        fmt.char('(')
        for i in Range.new(0, depth as i32) { fmt.str("*(") }
        fmt.str(lhs)
        for i in Range.new(0, depth as i32) { fmt.char(')') }
        fmt.sym(")._f", field_id).as_str()
    }

    expr_struct_init_field :: fn(self &Self, arena &Arena, field_id u32, val_str Str) Str {
        text.Fmt.new(arena).sym("._f", field_id).str(" = ").str(val_str).as_str()
    }

    expr_struct_init :: fn(self &Self, arena &Arena, struct_name, fields_body Str) Str {
        body := if fields_body.len > 0 { fields_body } else { "0" }
        if self.static_init {
            ret text.Fmt.new(arena).wrap("{", body, "}").as_str()
        }
        text.Fmt.new(arena).wrap("((", struct_name, "){").str(body).str("})").as_str()
    }

    reflection_symbol :: fn(self &Self, arena &Arena) Str {
        count := self.reflection_count
        self.reflection_count = count + 1
        text.Fmt.new(arena).sym("abyss_reflection_", count).as_str()
    }

    reflection_record :: fn(
        self &Self
        arena &Arena
        db &Nexus
        records &HashMap(u64, Str)
        ty u32
        value u64
    ) Str {
        if value == 0 {
            ret "0"
        }
        prior := records.get(value)
        if prior != (0 as &Str) {
            ret *prior
        }
        name := self.reflection_symbol(arena)
        address := self.expr_address(arena, name)
        records.insert(value, address)
        type_name := self.type_str(&db.types, arena, ty)
        self.declare_global(0, ty, name, type_name)

        out := text.Fmt.new(arena)
        out.str("{")
        fields := db.types.get_struct_fields(ty)
        for index in Range.new(0, (fields.len / 2) as i32) {
            i := index as u64
            field := fields.ptr[i * 2]
            field_ty := fields.ptr[i * 2 + 1]
            bits := (value as &u64)[i]
            out.str("._f").uint32(field).str(" = ")
            if field_ty == db.str_type {
                ptr := reflection.reflection_read(db, bits, field_ty, "ptr") as &u8
                len := reflection.reflection_read(db, bits, field_ty, "len")
                raw := reflection.reflection_quote(db, Str.new(ptr, len))
                out.str(
                    self.expr_str_lit(
                        arena
                        self.type_str(&db.types, arena, field_ty)
                        db.interner.intern("ptr")
                        db.interner.intern("len")
                        raw
                    )
                )
            } else if db.types.kind(field_ty) == type_defs.TyKind.ptr {
                child := db.types.payload(field_ty)
                if db.types.kind(child) != type_defs.TyKind.ptr {
                    out.str(self.reflection_record(arena, db, records, child, bits))
                } else {
                    field_name := db.interner.get(field)
                    count_name := if field_name.eq("fields") {
                        "field_count"
                    } else if field_name.eq("members") {
                        "member_count"
                    } else {
                        "param_count"
                    }
                    count := reflection.reflection_read(db, value, ty, count_name)
                    out.str(self.reflection_list(arena, db, records, child, bits, count))
                }
            } else {
                out.str(self.expr_u64(arena, bits))
            }
            out.str(", ")
        }
        out.str("}")
        self.initialize_global(name, type_name, out.as_str())
        address
    }

    reflection_list :: fn(
        self &Self
        arena &Arena
        db &Nexus
        records &HashMap(u64, Str)
        ty u32
        value u64
        count u64
    ) Str {
        if count == 0 {
            ret "0"
        }
        name := self.reflection_symbol(arena)
        out := text.Fmt.new(arena)
        out.str("static ").str(self.type_str(&db.types, arena, ty)).space().str(name).str("[] = {")
        item_ty := db.types.payload(ty)
        items := value as &&u8
        for index in Range.new(0, count as i32) {
            out.str(self.reflection_record(arena, db, records, item_ty, items[index] as u64))
            out.str(", ")
        }
        out.str("};\n")
        self.global_defs.push_str(out.as_str())
        name
    }

    expr_reflection :: fn(self &Self, arena &Arena, db &Nexus, ty u32, value u64) Str {
        previous := self.static_init
        self.static_init = true
        records := HashMap(u64, Str).new()
        address := self.reflection_record(arena, db, &records, ty, value)
        records.destroy()
        self.static_init = previous
        address
    }

    expr_sizeof :: fn(self &Self, arena &Arena, ty Str) Str {
        text.Fmt.new(arena).wrap("((uint64_t)sizeof(", ty, "))").as_str()
    }

    expr_union :: fn(self &Self, arena &Arena, union_name Str, tag u32, value Str) Str {
        body := text.fmt(
            arena
            " .tag = {}, .val = {{ ._v{} = {} }} "
            .{ tag, tag, value }
        ).as_str()
        self.expr_struct_init(arena, union_name, body)
    }

    expr_union_member :: fn(self &Self, arena &Arena, value Str, tag u32) Str {
        text.Fmt.new(arena).wrap("((", value, ").val").sym("._v", tag).char(')').as_str()
    }

    expr_union_tag :: fn(self &Self, arena &Arena, value Str) Str {
        text.Fmt.new(arena).wrap("((", value, ").tag)").as_str()
    }

    expr_union_is :: fn(self &Self, arena &Arena, value Str, tag u32) Str {
        text.Fmt.new(arena).wrap("(((", value, ").tag) == ").uint32(tag).char(')').as_str()
    }

    expr_enum_value :: fn(self &Self, arena &Arena, enum_name Str, value u32) Str {
        text.Fmt.new(arena).wrap("((", enum_name, ")").uint32(value).char(')').as_str()
    }

    expr_address_of_value :: fn(self &Self, arena &Arena, ty, value Str) Str {
        text.Fmt.new(arena).wrap("&((", ty, "[]){").str(value).str("})[0]").as_str()
    }

    expr_field_value :: fn(self &Self, arena &Arena, value Str, field_id u32) Str {
        self.expr_member(arena, value, 0, field_id)
    }

    expr_array_index :: fn(
        self &Self
        arena &Arena
        value, index Str
        elem_ty u32
        is_ptr bool
    ) Str {
        access := if is_ptr { "->" } else { "." }
        text.Fmt.new(arena).char('(').str(value).str(access).wrap("_v[", index, "])").as_str()
    }

    expr_slice_index :: fn(self &Self, arena &Arena, value, index Str, elem_ty, ptr_id u32) Str {
        text.Fmt.new(arena).char('(').str(value).sym("._f", ptr_id).wrap("[", index, "])").as_str()
    }

    expr_ptr_index :: fn(self &Self, arena &Arena, value, index Str, elem_ty u32) Str {
        text.Fmt.new(arena).char('(').str(value).wrap("[", index, "])").as_str()
    }

    expr_array_init :: fn(self &Self, arena &Arena, arr_name, elems Str, elem_ty, count u32) Str {
        body := if count == 0 { " 0 " } else {
            text.Fmt.new(arena).wrap(" { ", elems, " } ").as_str()
        }
        self.expr_struct_init(arena, arr_name, body)
    }

    expr_array_init_elem :: fn(self &Self, arena &Arena, val Str) Str {
        val
    }

    binary_op :: fn(self &Self, kind HirExprKind) Str {
        match kind {
            binary_add { " + " }
            binary_sub { " - " }
            binary_mul { " * " }
            binary_div { " / " }
            binary_mod { " % " }
            binary_eq_eq { " == " }
            binary_neq { " != " }
            binary_lt { " < " }
            binary_gt { " > " }
            binary_lt_eq { " <= " }
            binary_gt_eq { " >= " }
            binary_and { " && " }
            binary_or { " || " }
            binary_bit_and { " & " }
            binary_bit_or { " | " }
            binary_bit_xor { " ^ " }
            binary_shl { " << " }
            binary_shr { " >> " }
            else { " " }
        }
    }

    expr_binary_kind :: fn(self &Self, arena &Arena, kind HirExprKind, lhs Str, rhs Str) Str {
        self.expr_binary(arena, self.binary_op(kind), lhs, rhs)
    }

    expr_equal :: fn(self &Self, arena &Arena, lhs Str, rhs Str) Str {
        self.expr_binary(arena, " == ", lhs, rhs)
    }

    expr_or :: fn(self &Self, arena &Arena, lhs Str, rhs Str) Str {
        self.expr_binary(arena, " || ", lhs, rhs)
    }

    expr_less_equal :: fn(self &Self, arena &Arena, lhs Str, rhs Str) Str {
        self.expr_binary(arena, " <= ", lhs, rhs)
    }

    expr_add :: fn(self &Self, arena &Arena, lhs Str, rhs Str) Str {
        self.expr_binary(arena, " + ", lhs, rhs)
    }
}
